# The generated config uses grub-efi + a vfat ESP, so it only boots on UEFI.
# Refuse legacy-BIOS boots up front rather than producing an unbootable install.
[ -d /sys/firmware/efi ] || die "This machine appears to have booted in legacy
BIOS mode. The Security Ops installer currently supports UEFI systems only —
reboot in UEFI mode and try again."
SECURE_BOOT_STATE=$(secure_boot_state /sys/firmware/efi/efivars)
case "$SECURE_BOOT_STATE" in
  enabled)
    die "UEFI Secure Boot is enabled, but this release does not yet install a
signed GRUB/kernel chain. Disable Secure Boot before installation; the installer
will not erase a disk and leave an unbootable system." ;;
  disabled) ;;
  unavailable)
    die "UEFI mode is active, but the SecureBoot variable is unavailable. Because
this release installs an unsigned boot chain, the installer requires an explicit
SecureBoot=0 reading before any disk can be erased." ;;
  *)
    die "The UEFI Secure Boot variable could not be interpreted safely. Refusing
to install until boot policy can be determined." ;;
esac

