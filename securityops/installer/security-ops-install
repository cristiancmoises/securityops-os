  "fr"   "French" \
  "es"   "Spanish") || exit 1
[ "$KEYMAP" = "br" ] && XKBVARIANT="abnt2" || XKBVARIANT=""
apply_live_keyboard_layout "$KEYMAP" "$XKBVARIANT" || \
  die "The selected keyboard layout could not be applied to this trusted input path. Start the installer from the Sway session or from a real VT; XMonad/KDE users must log out and select Sway first. No password has been requested."
while :; do
  KEYBOARD_CHECK=$(input "Non-secret keyboard check: type exactly Yz09-_/\n\nVerify that the visible characters match before creating passwords:" "") || exit 1
  [ "$KEYBOARD_CHECK" = 'Yz09-_/' ] && break
  msg "The layout check did not match. Recheck the selected physical layout; no secret was recorded." 10
done
unset KEYBOARD_CHECK

LOCALE=$(menu "System locale:" \
  "en_US.UTF-8" "English (US)" \
  "pt_BR.UTF-8" "Português (Brasil)" \
  "en_GB.UTF-8" "English (UK)" \
  "de_DE.UTF-8" "Deutsch" \
  "fr_FR.UTF-8" "Français" \
  "es_ES.UTF-8" "Español") || exit 1

# timezone: region then city
TZREGION=$(menu "Timezone region:" \
  "America"   "America" \
  "Europe"    "Europe" \
  "Asia"      "Asia" \
  "Africa"    "Africa" \
  "Australia" "Australia" \
  "UTC"       "UTC (no region)") || exit 1
if [ "$TZREGION" = "UTC" ]; then
  TIMEZONE="UTC"
else
  ZI=/run/current-system/profile/share/zoneinfo
  # %P prints the path relative to the region dir, so nested zones like
  # Argentina/Buenos_Aires and Indiana/Indianapolis are reachable too.
  mapfile -t CITIES < <(find "$ZI/$TZREGION" -type f -printf '%P\n' 2>/dev/null | sort)
  ARGS=(); for c in "${CITIES[@]}"; do ARGS+=("$c" ""); done
  CITY=$(menu "Timezone ($TZREGION/…):" "${ARGS[@]}") || exit 1
  TIMEZONE="$TZREGION/$CITY"
fi

# ---------------------------------------------------------------------------
# 2. Hostname + accounts
# ---------------------------------------------------------------------------
while :; do
  HOSTNAME=$(input "Hostname:" "securityops") || exit 1
  securityops_valid_hostname "$HOSTNAME" && break
  msg "Hostname must be 1-63 chars: letters, digits, hyphen (no leading hyphen)." 9
done
while :; do
  USERNAME=$(input "Your username (lowercase):" "securityops") || exit 1
  if ! securityops_valid_username "$USERNAME"; then
    msg "Username must start with a lowercase letter or _, then only a-z 0-9 _ - (max 32)." 9; continue
  fi
  # reserved system accounts would collide with the base accounts (and the
  # generated config already defines its own root) → the install would abort
  # AFTER the disk is wiped.  Refuse them here.
  reserved_users=" root nobody daemon bin sys sync mail messagebus sshd guixbuilder nscd avahi colord gdm geoclue ntpd polkitd "
  if [[ "$reserved_users" == *" $USERNAME "* ]]; then
    msg "'$USERNAME' is a reserved system account name. Choose another." 9
    continue
  fi
  if [[ "$USERNAME" =~ ^guixbuilder[0-9]+$ ]]; then
    msg "'$USERNAME' is reserved for a Guix build account. Choose another." 9
    continue
  fi
  break
done
while :; do
  FULLNAME=$(input "Full name (optional):" "$USERNAME") || exit 1
  securityops_valid_gecos "$FULLNAME" "$TRUSTED_PYTHON" && break
  msg "Full name must be at most 128 printable characters and cannot contain ':' or control characters." 10
done
while :; do
  UPASS=$(password "Password for '$USERNAME':") || exit 1
  UPASS2=$(password "Confirm password for '$USERNAME':") || exit 1
  if [ "$UPASS" != "$UPASS2" ]; then
    msg "Passwords did not match. Try again." 9
    continue
  fi
  if ! securityops_admin_password_meets_policy "$UPASS" "$USERNAME" "$HOSTNAME"; then
    msg "Administrative passwords must be 12–128 printable US-ASCII bytes, must differ from the username and hostname, and cannot be a repeated character, common static value, or obvious keyboard/counting sequence. This is a deterministic minimum policy, not a strength score." 13
    continue
  fi
  break
done

# Hash the administrative password immediately and retain only its verifier in
# a root-owned volatile file.  It never becomes an argument, environment value,
# Guix configuration field, derivation input, or log record.  yescrypt is
# provided by the live profile's source-built mkpasswd/libxcrypt stack.
ADMIN_HASH_FILE=$(securityops_private_tempfile "$RUNTIME_DIR" admin-hash) || \
  die "Could not create protected volatile state for the administrative password."
if ! mkpasswd --method=yescrypt --password-fd=9 9<<<"$UPASS" >"$ADMIN_HASH_FILE"; then
  die "Could not hash the administrative password."
fi
unset UPASS UPASS2
# Literal yescrypt `$y$' prefix.
# shellcheck disable=SC2016
if ! grep -Eq '^\$y\$[^:[:space:]]+\$[^:[:space:]]+\$[^:[:space:]]+$' \
     "$ADMIN_HASH_FILE"; then
  die "The administrative password verifier has an unexpected format."
fi

# ---------------------------------------------------------------------------
# 3. Desktop / WM
# ---------------------------------------------------------------------------
DESKTOP=$(menu "Desktop / window manager:" \
  "sway" "Sway — Wayland tiling (default, fastest)" \
  "xmonad-xlibre" "XMonad — tiling on the pinned XLibre server" \
  "kde"  "KDE Plasma — full Wayland desktop") || exit 1

# ---------------------------------------------------------------------------
# 4. Disk, encryption, filesystem
# ---------------------------------------------------------------------------
# TYPE + SIZE are single tokens; MODEL (last) may contain spaces — so filter on
# the fixed-position TYPE column and take everything after SIZE as the model.
mapfile -t DISKS < <(lsblk -dn -o NAME,TYPE,SIZE,MODEL | \
  awk '$2=="disk" && $1 !~ /^(zram|loop|sr|fd|md|dm-)/ {name=$1; size=$3; $1=$2=$3=""; sub(/^ +/,""); printf "%s\t%s  %s\n", name, size, $0}')
[ "${#DISKS[@]}" -gt 0 ] || die "No disks detected."
DARGS=(); for d in "${DISKS[@]}"; do DARGS+=("/dev/$(echo "$d"|cut -f1)" "$(echo "$d"|cut -f2-)"); done
DISK=$(menu "Target disk (WILL BE ERASED):" "${DARGS[@]}") || exit 1
[ -b "$DISK" ] || die "$DISK is not a block device."
# Guard 1: resolve root= from the kernel command line and refuse its physical
# backing disk.  Fail closed if a non-optical live root cannot be traced: an
# installer that cannot identify its own medium is not safe to partition disks.
ROOT_SPEC=$(cmdline_root_spec /proc/cmdline || true)
[ -n "$ROOT_SPEC" ] || die "Could not identify the live root from /proc/cmdline.
Refusing to partition any disk because the boot medium cannot be protected."
mapfile -t LIVE_ROOT_DEVICES < <(resolve_root_devices "$ROOT_SPEC")
[ "${#LIVE_ROOT_DEVICES[@]}" -gt 0 ] || die "Could not resolve every live-root
device matching '$ROOT_SPEC'. Refusing to partition any disk."
LIVE_BACKING_DISKS=()
for live_root_device in "${LIVE_ROOT_DEVICES[@]}"; do
  LIVE_ROOT_TYPE=$(lsblk -dnro TYPE "$live_root_device" 2>/dev/null | head -1 || true)
  if [ "$LIVE_ROOT_TYPE" != rom ]; then
    mapfile -t candidate_backing_disks < <(backing_disks "$live_root_device")
    [ "${#candidate_backing_disks[@]}" -gt 0 ] || \
      die "Could not trace live root '$live_root_device' to all physical backing disks."
    LIVE_BACKING_DISKS+=("${candidate_backing_disks[@]}")
  fi
done
if [ "${#LIVE_BACKING_DISKS[@]}" -gt 0 ]; then
  mapfile -t LIVE_BACKING_DISKS < <(printf '%s\n' "${LIVE_BACKING_DISKS[@]}" | sort -u)
fi
TARGET_DISK=$(readlink -f -- "$DISK")
TARGET_TYPE=$(lsblk -dnro TYPE "$TARGET_DISK" 2>/dev/null || true)
TARGET_MAJMIN=$(lsblk -dnro MAJ:MIN "$TARGET_DISK" 2>/dev/null || true)
TARGET_SYSFS=$(readlink -f -- "/sys/dev/block/$TARGET_MAJMIN" 2>/dev/null || true)
TARGET_SIZE=$(blockdev --getsize64 "$TARGET_DISK" 2>/dev/null || true)
TARGET_DISKSEQ=$(blockdev --getdiskseq "$TARGET_DISK" 2>/dev/null || true)
TARGET_WWN=$(lsblk -dnro WWN "$TARGET_DISK" 2>/dev/null | tr -d '[:space:]')
TARGET_SERIAL=$(lsblk -dnro SERIAL "$TARGET_DISK" 2>/dev/null | tr -d '[:space:]')
MINIMUM_DISK_BYTES=$((64 * 1024 * 1024 * 1024))
if [ "$TARGET_TYPE" != disk ] || [ -z "$TARGET_MAJMIN" ] || \
   [ -z "$TARGET_SYSFS" ] || [[ ! "$TARGET_SIZE" =~ ^[0-9]+$ ]] || \
   [[ ! "$TARGET_DISKSEQ" =~ ^[0-9]+$ ]]; then
  die "Could not capture a stable identity for $DISK. Refusing to continue."
fi
[ "$TARGET_SIZE" -ge "$MINIMUM_DISK_BYTES" ] || \
  die "$DISK is smaller than the supported 64 GiB installation minimum."
log "live root $ROOT_SPEC -> ${LIVE_ROOT_DEVICES[*]} -> ${LIVE_BACKING_DISKS[*]:-optical}; target $TARGET_DISK ($TARGET_MAJMIN seq=$TARGET_DISKSEQ $TARGET_SIZE bytes wwn=${TARGET_WWN:-none} serial=${TARGET_SERIAL:-none})"
for live_disk in "${LIVE_BACKING_DISKS[@]}"; do
  [ "$live_disk" != "$TARGET_DISK" ] || \
    die "$DISK backs the live system. Refusing to wipe the live medium."
done
# Mounted targets must be unmounted explicitly before installation.  Merely
# warning and continuing allows wipefs/mkfs to corrupt a filesystem still in use.
TARGET_BUSY_REASON=$(device_tree_busy_reason "$TARGET_DISK")
[ -z "$TARGET_BUSY_REASON" ] || \
  die "$DISK is in use: $TARGET_BUSY_REASON. Deactivate it explicitly, then restart the installer."

if yesno "Encrypt the root volume with LUKS2?\n\n(Strongly recommended. The UEFI system partition remains unencrypted. You'll set a passphrase now.)"; then
  ENCRYPT=yes
  if [ "$KEYMAP" != us ]; then
    msg "The pinned GRUB 2.14 cryptomount prompt appears before the installed keyboard map is loaded. LUKS entry therefore uses the US layout. The installer will temporarily switch this trusted input path to US for passphrase creation; the installed desktop will still use '$KEYMAP'." 13
    apply_live_keyboard_layout us "" || \
      die "Could not apply the mandatory US layout for early-boot LUKS input. No passphrase was requested."
    while :; do
      KEYBOARD_CHECK=$(input "Non-secret LUKS keyboard check (US layout): type exactly Yz09-_/\n\nThe first cold-boot unlock prompt will use this mapping:" "") || exit 1
      [ "$KEYBOARD_CHECK" = 'Yz09-_/' ] && break
      msg "The US-layout LUKS check did not match. No secret was recorded." 10
    done
    unset KEYBOARD_CHECK
  fi
  while :; do
    LPASS=$(password "LUKS passphrase for $DISK:") || exit 1
    LPASS2=$(password "Confirm LUKS passphrase:") || exit 1
    if [ "$LPASS" != "$LPASS2" ]; then
      msg "Passphrases did not match. Try again." 9
      continue
    fi
    if ! securityops_luks_passphrase_meets_policy "$LPASS" "$USERNAME" "$HOSTNAME"; then
      msg "LUKS passphrases must be 20–254 printable US-ASCII bytes, must differ from the username and hostname, and cannot be a repeated character, common static value, or obvious keyboard/counting sequence. The 254-byte ceiling matches the pinned GRUB 2.14 input buffer." 14
      continue
    fi
    break
  done
  if [ "$KEYMAP" != us ]; then
    apply_live_keyboard_layout "$KEYMAP" "$XKBVARIANT" || \
      die "The selected desktop keyboard layout could not be restored after protected LUKS entry."
  fi
else
  ENCRYPT=no
fi

while :; do
  FS=$(menu "Root filesystem:" \
    "ext4"  "ext4 — stable, universal (recommended)" \
    "btrfs" "Btrfs — snapshots, compression" \
    "xfs"   "XFS — high-throughput" \
    "zfs"   "ZFS — planned (not selectable yet)") || exit 1
  # Root-on-ZFS needs an out-of-tree module the Security Ops kernel does not
  # carry (and a pool-import service).  Rather than wipe the disk and fail at
  # `guix system init', refuse ZFS up front and let the user pick again.
  if [ "$FS" = "zfs" ]; then
    msg "ZFS root is not yet bootable on the Security Ops kernel (no in-tree ZFS\nmodule). Please choose ext4, Btrfs, or XFS for now." 11
    continue
  fi
  break
done

# ---------------------------------------------------------------------------
# 5. Summary + typed confirmation
# ---------------------------------------------------------------------------
SUMMARY="Please review — this will ERASE $DISK:

  Disk        : $DISK
  Encryption  : $([ "$ENCRYPT" = yes ] && echo 'LUKS2 (yes)' || echo 'none')
  Filesystem  : $FS
  Desktop     : $DESKTOP
  Hostname    : $HOSTNAME
  User        : $USERNAME
  Locale      : $LOCALE
  Timezone    : $TIMEZONE
  Keyboard    : $KEYMAP $XKBVARIANT
  LUKS input  : $([ "$ENCRYPT" = yes ] && echo 'US layout at first GRUB prompt' || echo 'not applicable')
  Kernel      : linux-securityops $KERNEL_VERSION (hardened)"
# Show the full review in a TALL msgbox (an inputbox would clip the last lines),
# then ask for the typed confirmation in its own short box.
whiptail --title "$TITLE — review" --scrolltext --msgbox "$SUMMARY" 20 76
CONFIRM=$(input "This ERASES $DISK. To proceed, type the target device path EXACTLY:" "") || exit 1
[ "$CONFIRM" = "$DISK" ] || die "Confirmation did not match ($CONFIRM ≠ $DISK). Aborted — nothing changed."

# ===========================================================================
# EXECUTION — from here on the disk is modified.
# ===========================================================================
# Refuse resource collisions before claiming ownership of any teardown action.
# A stale/foreign /mnt or cryptroot must never be unmounted or closed by this
# installer.  The Guix store overlay is created later in a private mount
# namespace, so no global cow-store Shepherd service can collide.
if findmnt -rn -M /mnt >/dev/null 2>&1; then
  die "/mnt is already mounted. Refusing to disturb unrelated state."
fi
if [ -L /mnt ] || { [ -e /mnt ] && [ ! -d /mnt ]; }; then
  die "/mnt exists but is not a safe directory. Refusing to continue."
fi
if [ -d /mnt ] && find /mnt -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
  die "/mnt is not empty. Refusing to hide or overwrite unrelated state."
fi
if [ -e /dev/mapper/cryptroot ] || [ -L /dev/mapper/cryptroot ] || \
   cryptsetup status cryptroot >/dev/null 2>&1; then
  die "A cryptroot mapping already exists. Refusing to close or replace it."
fi

# Whole-disk device names ending in a digit use a `pN' partition suffix
# (nvme0n1p1, mmcblk0p1, nbd0p1, pmem0p1, ...).  Compute this before any write.
case "$TARGET_DISK" in
  *[0-9]) P1="${TARGET_DISK}p1"; P2="${TARGET_DISK}p2" ;;
  *) P1="${TARGET_DISK}1"; P2="${TARGET_DISK}2" ;;
esac

# Close the selection-to-wipe hotplug window: the canonical node, device type,
# kernel major/minor identity, sysfs object, size, mount state, and every current
# live-root backing disk must still match immediately before wipefs.
require_target_identity "the final pre-wipe gate"
CURRENT_TARGET_BUSY_REASON=$(device_tree_busy_reason "$TARGET_DISK")
[ -z "$CURRENT_TARGET_BUSY_REASON" ] || \
  die "Target use changed after confirmation: $CURRENT_TARGET_BUSY_REASON. Refusing to wipe it."
CURRENT_ROOT_SPEC=$(cmdline_root_spec /proc/cmdline || true)
[ "$CURRENT_ROOT_SPEC" = "$ROOT_SPEC" ] || \
  die "The live-root specification changed before the wipe."
mapfile -t CURRENT_LIVE_ROOT_DEVICES < <(resolve_root_devices "$CURRENT_ROOT_SPEC")
[ "${#CURRENT_LIVE_ROOT_DEVICES[@]}" -gt 0 ] || \
  die "Could not revalidate every live-root match immediately before the wipe."
[ "${CURRENT_LIVE_ROOT_DEVICES[*]}" = "${LIVE_ROOT_DEVICES[*]}" ] || \
  die "The set of live-root devices changed before the wipe."
CURRENT_LIVE_BACKING_DISKS=()
for current_live_root_device in "${CURRENT_LIVE_ROOT_DEVICES[@]}"; do
  CURRENT_LIVE_ROOT_TYPE=$(lsblk -dnro TYPE "$current_live_root_device" 2>/dev/null | head -1 || true)
  if [ "$CURRENT_LIVE_ROOT_TYPE" != rom ]; then
    mapfile -t candidate_backing_disks < <(backing_disks "$current_live_root_device")
    [ "${#candidate_backing_disks[@]}" -gt 0 ] || \
      die "Could not revalidate a live-root backing disk before the wipe."
    CURRENT_LIVE_BACKING_DISKS+=("${candidate_backing_disks[@]}")
  fi
done
if [ "${#CURRENT_LIVE_BACKING_DISKS[@]}" -gt 0 ]; then
  mapfile -t CURRENT_LIVE_BACKING_DISKS < <(printf '%s\n' "${CURRENT_LIVE_BACKING_DISKS[@]}" | sort -u)
fi
[ "${CURRENT_LIVE_BACKING_DISKS[*]}" = "${LIVE_BACKING_DISKS[*]}" ] || \
  die "The live-root backing topology changed before the wipe."
for live_disk in "${CURRENT_LIVE_BACKING_DISKS[@]}"; do
  [ "$live_disk" != "$TARGET_DISK" ] || \
    die "The confirmed target now backs the live system. Refusing to wipe it."
done

WIPED=1                        # the on_err trap now cleans up + tells the truth
{
# --- partition: GPT, 512M ESP + rest for root ------------------------------
log "wiping + partitioning $DISK"
require_target_unclaimed_identity "wipefs"
wipefs -a "$TARGET_DISK"
require_target_unclaimed_identity "GPT label creation"
parted -s "$TARGET_DISK" mklabel gpt
require_target_unclaimed_identity "ESP creation"
parted -s "$TARGET_DISK" mkpart ESP fat32 1MiB 513MiB
require_target_unclaimed_identity "ESP type update"
parted -s "$TARGET_DISK" set 1 esp on
require_target_unclaimed_identity "root partition creation"
parted -s "$TARGET_DISK" mkpart securityops-root 513MiB 100%
require_target_unclaimed_identity "partition-table reread"
blockdev --rereadpt "$TARGET_DISK"
require_target_unclaimed_identity "partition probe"
partprobe "$TARGET_DISK"

# Wait for the kernel to create the partition device nodes (settle) instead of a
# blind sleep — a hardcoded delay races mkfs on slow/loaded systems.
udevadm settle --timeout=15
for _ in $(seq 1 75); do { [ -b "$P1" ] && [ -b "$P2" ]; } && break; sleep 0.2; done
{ [ -b "$P1" ] && [ -b "$P2" ]; } || die "Partition nodes $P1/$P2 never appeared."
validate_created_partition_layout || \
  die "The kernel partition view does not match the new Security Ops GPT layout. Refusing to format possibly stale device nodes."

require_target_unclaimed_identity "ESP formatting"
validate_created_partition_layout || die "Partition identity changed before ESP formatting."
mkfs.fat -F32 -n EFI "$P1"

# --- optional LUKS ---------------------------------------------------------
if [ "$ENCRYPT" = yes ]; then
  log "luksFormat $P2"
  require_target_unclaimed_identity "LUKS formatting"
  validate_created_partition_layout || die "Partition identity changed before LUKS formatting."
  # The exact pinned GRUB EFI 2.14 build includes luks2.mod + argon2.mod.  Its
  # OVMF pre-boot harness opened this bounded Argon2id profile successfully.
  # Pin every cost rather than accepting a host-speed benchmark result; the
  # complete installed-image cold boot remains a mandatory release gate.
  printf '%s' "$LPASS" | cryptsetup luksFormat \
    --type luks2 --cipher aes-xts-plain64 --key-size 512 \
    --pbkdf argon2id --pbkdf-memory 65536 --pbkdf-parallel 1 \
    --pbkdf-force-iterations 4 \
    --batch-mode --key-file=- "$P2"
  if ! cryptsetup luksDump --dump-json-metadata "$P2" | \
       "$TRUSTED_PYTHON" -I -S -c '
import json, sys
metadata = json.load(sys.stdin)
slots = metadata.get("keyslots", {})
if len(slots) != 1:
    raise SystemExit(2)
kdf = next(iter(slots.values())).get("kdf", {})
expected = {"type": "argon2id", "time": 4, "memory": 65536, "cpus": 1}
if any(kdf.get(name) != value for name, value in expected.items()):
    raise SystemExit(3)
'; then
    die "The LUKS2 keyslot does not match the tested pinned-GRUB Argon2id parameters."
  fi
  LUKS_UUID=$(cryptsetup luksUUID "$P2" 2>/dev/null || true)
  [ -n "$LUKS_UUID" ] || die "Could not read the LUKS container UUID from $P2."
  EXPECTED_CRYPT_SOURCE=$(readlink -f -- "$P2" 2>/dev/null || true)
  [ -n "$EXPECTED_CRYPT_SOURCE" ] || die "Could not bind cryptroot to its source partition."
  require_target_unclaimed_identity "LUKS mapping"
  validate_created_partition_layout || die "Partition identity changed before LUKS mapping."
  CRYPTROOT_OPEN_ATTEMPTED=1
  printf '%s' "$LPASS" | cryptsetup open --key-file=- "$P2" cryptroot
  CRYPTROOT_OPENED=1
  unset LPASS LPASS2
  ROOTDEV=/dev/mapper/cryptroot
else
  ROOTDEV="$P2"
fi

# --- make the chosen filesystem -------------------------------------------
log "mkfs $FS on $ROOTDEV"
if [ "$ENCRYPT" = yes ]; then
  require_target_identity "root filesystem formatting"
else
  require_target_unclaimed_identity "root filesystem formatting"
fi
validate_created_partition_layout || die "Partition identity changed before root filesystem formatting."
case "$FS" in
  ext4)  mkfs.ext4  -F -L securityops "$ROOTDEV";;
  btrfs) mkfs.btrfs -f -L securityops "$ROOTDEV";;
  xfs)   mkfs.xfs   -f -L securityops "$ROOTDEV";;
  zfs)   zpool create -f -o ashift=12 -O mountpoint=none -O compression=zstd \
             -O acltype=posixacl -O xattr=sa securityops "$ROOTDEV"
         zfs create -o mountpoint=/ securityops/root;;
esac

# --- mount target ----------------------------------------------------------
EXPECTED_ROOTDEV_MAJMIN=$(lsblk -dnro MAJ:MIN "$ROOTDEV" 2>/dev/null || true)
[[ "$EXPECTED_ROOTDEV_MAJMIN" =~ ^[0-9]+:[0-9]+$ ]] || \
  die "Could not bind the target mount to its formatted device."
require_target_identity "target mount"
validate_created_partition_layout || die "Partition identity changed before target mount."
TARGET_MOUNT_ATTEMPTED=1
if [ "$FS" = zfs ]; then
  zpool export securityops; zpool import -R /mnt securityops; zfs mount securityops/root
else
  mount "$ROOTDEV" /mnt
fi
TARGET_MOUNTED=1
mkdir -p /mnt/boot/efi /mnt/etc
require_target_identity "ESP mount"
validate_created_partition_layout || die "Partition identity changed before ESP mount."
mount "$P1" /mnt/boot/efi

# Read the UUIDs the generated config keys on, WITH validation + a settle retry —
# an empty root UUID would otherwise fail `guix system init' AFTER the wipe.
EFI_UUID=$(blkid -s UUID -o value "$P1" 2>/dev/null || true)
[ -n "$EFI_UUID" ] || die "Could not read the ESP UUID from $P1."
ROOT_UUID=""
if [ "$ENCRYPT" != yes ] && [ "$FS" != zfs ]; then
  for _ in $(seq 1 25); do
    ROOT_UUID=$(blkid -s UUID -o value "$ROOTDEV" 2>/dev/null || true)
    [ -n "$ROOT_UUID" ] && break; sleep 0.2
  done
  [ -n "$ROOT_UUID" ] || die "Could not read the new root filesystem UUID from $ROOTDEV."
fi
} 2>>"$LOG"

# ---------------------------------------------------------------------------
# 6. Generate /mnt/etc/config.scm from the choices
# ---------------------------------------------------------------------------
log "generating config.scm ($DESKTOP / $FS / encrypt=$ENCRYPT)"
# Both root and the administrative user stay declaratively locked.  The
# protected verifier is applied directly to the target shadow database only
# after `guix system init' succeeds, so it never enters the Guix store.
"$CONFIG_GENERATOR" \
  --out /mnt/etc/config.scm \
  --host "$HOSTNAME" --user "$USERNAME" --fullname "$FULLNAME" \
  --locale "$LOCALE" --tz "$TIMEZONE" --keymap "$KEYMAP" --xkbvariant "$XKBVARIANT" \
  --desktop "$DESKTOP" --fs "$FS" --encrypt "$ENCRYPT" \
  --root-uuid "$ROOT_UUID" --efi-uuid "$EFI_UUID" \
  --luks-uuid "${LUKS_UUID:-}" 2>>"$LOG"

# Copy the (securityops …) module tree to the TARGET so the installed system can
# use its pinned time-machine for every future reconfigure.  `guix system init'
# does not carry these source modules across on its own.
log "copying securityops src to target"
mkdir -p /mnt/etc/securityops
cp -a -- "$SRC" /mnt/etc/securityops/src 2>>"$LOG" || \
  die "Could not copy the authenticated Security Ops modules to the target. The disk is partially prepared, but no unsupported manual-finish path is offered."

# ---------------------------------------------------------------------------
# 7. Install
# ---------------------------------------------------------------------------
# Build & install inside a dedicated mount namespace.  The helper temporarily
# stops the host Guix daemon, snapshots its database, mounts the target-backed
# store overlay only in that namespace, runs the exact authenticated
# time-machine command, then restores the database/daemon and unmounts through
# dynamic-wind.  No global cow-store mount survives the command.
log "pinned guix time-machine: system init"
clear
cat <<BANNER
  ────────────────────────────────────────────────────────────────
   Security Ops OS — installing to $DISK
   $FS · $([ "$ENCRYPT" = yes ] && echo 'LUKS2 encrypted' || echo 'no encryption') · $DESKTOP desktop · kernel $KERNEL_VERSION
   This downloads/builds the full system; it can take a while.
   Full log: $LOG
  ────────────────────────────────────────────────────────────────
BANNER
GUIX_DB_BACKUP_FILE=$(securityops_private_tempfile "$RUNTIME_DIR" guix-db) || \
  die "Could not create a protected Guix database snapshot path."
# Run the helper as a direct, monitored child in its own session/process group.
# Bash traps forward HUP/INT/TERM/QUIT and do not release target/private state
# until this exact child and every member of its group have terminated.
COW_HELPER_ACTIVE=1
COW_HELPER_LAUNCH_IN_PROGRESS=1
COW_HELPER_PID=""
COW_HELPER_PGID=""
GUILE_EXTENSIONS_PATH="$TRUSTED_GUILE_EXTENSIONS" \
"$TRUSTED_SETSID" "$TRUSTED_FLOCK" -n -E 75 --no-fork "$COW_LOCK_FILE" \
  "$TRUSTED_GUILE" -L "$TRUSTED_GUILE_SITE" -C "$TRUSTED_GUILE_CCACHE" \
  -s "$COW_INIT_HELPER" /mnt /mnt/etc/config.scm "$PINNED_CHANNELS" "$SRC" \
  "$SUBSTITUTE_URLS" "$GUIX_DB_BACKUP_FILE" "$TRUSTED_CERT_FILE" \
  "$TRUSTED_CERT_DIR" "$PRIVILEGED_STATE_ROOT" "$$" \
  "$INSTALLER_START_TIME" "$TRUSTED_FLOCK" "$TRUSTED_GUIX" >>"$LOG" 2>&1 &
COW_HELPER_PID=$!
[[ "$COW_HELPER_PID" =~ ^[1-9][0-9]*$ ]] || {
  COW_HELPER_LAUNCH_IN_PROGRESS=0
  die "Mount-namespace helper launch did not return a valid child PID. Target and private state remain guarded."
}
helper_identity_ok=0
for _ in $(seq 1 100); do
  if [ -r "/proc/$COW_HELPER_PID/stat" ]; then
    IFS= read -r helper_status <"/proc/$COW_HELPER_PID/stat" || true
    helper_status=${helper_status##*) }
    read -r _ helper_ppid helper_pgid _ <<<"$helper_status"
    if [ "$helper_ppid" = "$$" ] && [ "$helper_pgid" = "$COW_HELPER_PID" ]; then
      COW_HELPER_PGID=$helper_pgid
      helper_identity_ok=1
      break
    fi
  fi
  cow_helper_pid_running || break
  sleep 0.05
done
unset helper_status helper_ppid helper_pgid
if [ "$helper_identity_ok" != 1 ]; then
  COW_HELPER_LAUNCH_IN_PROGRESS=0
  if ! terminate_owned_cow_helper TERM; then
    die "Mount-namespace helper identity was ambiguous and its authenticated lifecycle could not be recovered. Target and private state remain guarded; reboot before retrying."
  fi
  die "Mount-namespace helper did not establish its required owned process group."
fi
unset helper_identity_ok
COW_HELPER_LAUNCH_IN_PROGRESS=0
if [ -n "$COW_PENDING_SIGNAL_STATUS" ]; then
  pending_signal_status=$COW_PENDING_SIGNAL_STATUS
  pending_signal_name=$COW_PENDING_SIGNAL_NAME
  COW_PENDING_SIGNAL_STATUS=""
  COW_PENDING_SIGNAL_NAME=""
  on_signal "$pending_signal_status" "$pending_signal_name"
fi
rc=0
wait_owned_cow_helper || rc=$?
if [ "$rc" -eq 0 ]; then
  [ ! -e "$GUIX_DB_BACKUP_FILE" ] || \
    die "Mount-namespace init returned success but left its Guix database snapshot behind."
  GUIX_DB_BACKUP_FILE=""
else
  log "mount-namespace system init failed; protected database snapshot retained at $GUIX_DB_BACKUP_FILE"
fi

# grub.cfg is written at the very END of `guix system init' (bootloader install
# is the last step), so its presence + rc==0 is a trustworthy success signal —
# unlike /mnt/gnu/store, which appears early and would false-positive.
if [ "$rc" -eq 0 ] && [ -e /mnt/boot/grub/grub.cfg ]; then
  # Guix deliberately preserves an existing shadow entry on later
  # reconfigurations.  Activate only the validated administrative account now,
  # after its locked declaration has built successfully.  chpasswd receives the
  # username/verifier pair on stdin inside the target root; neither value is an
  # argument, environment entry, or log payload.
  for account_file in /mnt/etc/passwd /mnt/etc/shadow; do
    if [ ! -f "$account_file" ] || [ -L "$account_file" ]; then
      die "Installed account database is missing or unsafe: $account_file"
    fi
  done
  securityops_private_directory "$RUNTIME_DIR" || \
    die "Protected installer state became unsafe before account activation."
  # Literal yescrypt `$y$' prefix.
  # shellcheck disable=SC2016
  if [ ! -f "$ADMIN_HASH_FILE" ] || [ -L "$ADMIN_HASH_FILE" ] || \
     [ "$(stat -c '%u:%g:%a' -- "$ADMIN_HASH_FILE")" != "0:0:600" ] || \
     ! grep -Eq '^\$y\$[^:[:space:]]+\$[^:[:space:]]+\$[^:[:space:]]+$' \
       "$ADMIN_HASH_FILE"; then
    die "Protected administrative password state became invalid."
  fi
  if ! awk -v user="$USERNAME" '
      NR == 1 { print user ":" $0 }
      END { if (NR != 1) exit 1 }
    ' "$ADMIN_HASH_FILE" | \
    chpasswd --encrypted --root /mnt >>"$LOG" 2>&1; then
    die "The system was built, but the administrative password could not be activated."
  fi
  if ! awk -F: -v user="$USERNAME" '
      $1 == user { print $2; matches++ }
      END { if (matches != 1) exit 1 }
    ' /mnt/etc/shadow | cmp -s - "$ADMIN_HASH_FILE"; then
    die "The installed administrative password verifier did not match protected state."
  fi
  # Both declarative accounts remain locked until this target-shadow update is
  # durable.  Force the exact shadow file and its target filesystem to stable
  # storage before deleting the only protected verifier or announcing success.
  "$TRUSTED_SYNC" -f /mnt/etc/shadow >>"$LOG" 2>&1 || \
    die "The administrative password was applied but could not be made durable. The protected verifier was retained."
  "$TRUSTED_SYNC" -f /mnt >>"$LOG" 2>&1 || \
    die "The installed root filesystem could not be synchronized after account activation. The protected verifier was retained."
  # The ESP is a separate vfat filesystem.  Re-bind it to the installer-owned
  # partition immediately before syncfs so a replaced mount cannot receive the
  # durability operation intended for the boot chain.
  require_target_identity "final ESP durability sync"
  validate_created_partition_layout || \
    die "Partition identity changed before final ESP durability sync. The protected verifier was retained."
  if [ ! -d /mnt/boot/efi ] || [ -L /mnt/boot/efi ]; then
    die "The installed EFI mount point became unsafe. The protected verifier was retained."
  fi
  expected_esp_major_minor=$(lsblk -dnro MAJ:MIN "$P1" 2>/dev/null || true)
  mounted_esp_major_minor=$(findmnt -nro MAJ:MIN -M /mnt/boot/efi 2>/dev/null || true)
  if [[ ! "$expected_esp_major_minor" =~ ^[0-9]+:[0-9]+$ ]] || \
     [ "$mounted_esp_major_minor" != "$expected_esp_major_minor" ]; then
    die "The installed EFI filesystem no longer matches the installer-owned ESP. The protected verifier was retained."
  fi
  "$TRUSTED_SYNC" -f /mnt/boot/efi >>"$LOG" 2>&1 || \
    die "The installed EFI filesystem could not be synchronized. The protected verifier was retained."
  unset expected_esp_major_minor mounted_esp_major_minor
  rm -f -- "$ADMIN_HASH_FILE"
  ADMIN_HASH_FILE=""
  "$TRUSTED_SYNC" >>"$LOG" 2>&1 || \
    die "The installed filesystems could not complete their final synchronization."
  cleanup_target_state || \
    die "Installation finished, but installer-owned mounts or encryption mappings could not be released. Do not reboot until the private log is reviewed."
  REBOOT_NOW=no
  if whiptail --title "$TITLE" --yesno \
      "Security Ops OS is synchronized and installer-owned target state is closed.\n\nReboot now? Keep the installation medium attached until reboot begins, then remove it to avoid returning to the live environment." 14 76; then
    REBOOT_NOW=yes
  fi
  if [ "$REBOOT_NOW" = yes ]; then
    reboot
  else
    msg "Installation is complete. Installer-owned mounts and mappings are closed; remove the installation medium before rebooting." 11
  fi
else
  die "guix system init failed (exit $rc). The disk was partitioned but the
system was NOT fully installed. Inspect $LOG before retrying."
fi
