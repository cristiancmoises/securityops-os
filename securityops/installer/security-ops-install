apply_live_keyboard_layout(){
  local xkb_layout=$1 xkb_variant=$2 console_keymap="" caller_uid=""
  local runtime_directory runtime_metadata sway_socket socket_metadata tty_path
  local -a sway_sockets=()
  local applied=0 sway_command

  case "$xkb_layout:$xkb_variant" in
    us:)       console_keymap=us ;;
    br:abnt2) console_keymap=br-abnt2 ;;
    gb:)       console_keymap=uk ;;
    de:)       console_keymap=de ;;
    fr:)       console_keymap=fr ;;
    es:)       console_keymap=es ;;
    *) return 1 ;;
  esac

  # The trusted installer input path is Sway.  Apply the requested XKB mapping through the
  # caller-owned IPC socket while executing swaymsg as that unprivileged user,
  # so a hostile socket can never feed parser input to a root swaymsg process.
  caller_uid=${SUDO_UID:-}
  if [[ "$caller_uid" =~ ^[1-9][0-9]*$ ]]; then
    runtime_directory="/run/user/$caller_uid"
    runtime_metadata=$(stat -Lc '%u:%a' -- "$runtime_directory" 2>/dev/null || true)
    if [[ "$runtime_metadata" == "$caller_uid:700" && ! -L "$runtime_directory" ]]; then
      shopt -s nullglob
      for sway_socket in "$runtime_directory"/sway-ipc."$caller_uid".*.sock; do
        socket_metadata=$(stat -Lc '%u' -- "$sway_socket" 2>/dev/null || true)
        if [[ ! -L "$sway_socket" && -S "$sway_socket" &&
              "$socket_metadata" == "$caller_uid" ]]; then
          sway_sockets+=("$sway_socket")
        fi
      done
      shopt -u nullglob
      if [ "${#sway_sockets[@]}" -eq 1 ]; then
        sway_command="input type:keyboard xkb_layout \"$xkb_layout\"; input type:keyboard xkb_variant \"$xkb_variant\""
        if "$TRUSTED_SETUID_SUDO" -u "#$caller_uid" -- \
             "$TRUSTED_SWAYMSG" -s "${sway_sockets[0]}" "$sway_command" \
             >>"$LOG" 2>&1; then
          applied=1
        fi
      fi
    fi
  fi

  # A direct VT installation has no compositor.  Apply the corresponding
  # console map there; do not call loadkeys from a pseudo-terminal and mistake
  # a global console change for a successful graphical layout switch.
  tty_path=$(tty 2>/dev/null || true)
  if [[ "$tty_path" =~ ^/dev/tty[0-9]+$ ]]; then
    if "$TRUSTED_LOADKEYS" "$console_keymap" >>"$LOG" 2>&1; then
      applied=1
    fi
  fi

  [ "$applied" -eq 1 ]
}

# Resolve the immutable live root named on the kernel command line.  `/` itself
# is an overlay after Guix switches root, so findmnt(8) on `/` cannot identify
# the USB and must never be used as the destructive-write guard.
cmdline_root_spec(){
  local cmdline_path="$1" word
  local -a words=() root_specs=()
  [ -r "$cmdline_path" ] || return 1
  read -r -a words < "$cmdline_path"
  for word in "${words[@]}"; do
    case "$word" in root=*) root_specs+=("${word#root=}");; esac
  done
  # The pinned Guix initrd consumes the first root= argument.  Requiring exactly
  # one avoids protecting a later decoy when conflicting arguments are present.
  [ "${#root_specs[@]}" -eq 1 ] && [ -n "${root_specs[0]}" ] || return 1
  printf '%s\n' "${root_specs[0]}"
}
resolve_root_devices(){
  local spec="$1" tag="" value="" dev="" encoded=""
  case "$spec" in
    UUID=*) tag=UUID; value=${spec#UUID=} ;;
    LABEL=*) tag=LABEL; value=${spec#LABEL=} ;;
    PARTUUID=*) tag=PARTUUID; value=${spec#PARTUUID=} ;;
    PARTLABEL=*) tag=PARTLABEL; value=${spec#PARTLABEL=} ;;
    # GRUB generated for the current live ISO passes its filesystem UUID as a
    # bare root= value.  Accept only the strict DCE form and enumerate *every*
    # matching block device so a cloned UUID cannot hide a writable live disk.
    [0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f])
      # Guix's ISO9660 GRUB code renders the 16 ASCII timestamp digits as a
      # DCE UUID.  Decode that exact representation back to blkid's ISO UUID
      # (YYYY-MM-DD-HH-MM-SS-CC); do not reinterpret arbitrary bare values.
      encoded=${spec//-/}
      value=$("$TRUSTED_PYTHON" -I -S -c '
import re, sys
raw = bytes.fromhex(sys.argv[1]).decode("ascii")
if not re.fullmatch(r"[0-9]{16}", raw):
    raise SystemExit(2)
print(f"{raw[0:4]}-{raw[4:6]}-{raw[6:8]}-{raw[8:10]}-{raw[10:12]}-{raw[12:14]}-{raw[14:16]}")
' "$encoded" 2>/dev/null) || return 1
      tag=UUID ;;
    /dev/*)
      dev=$(readlink -f -- "$spec" 2>/dev/null || true);;
    *) return 1;;
  esac
  if [ -n "$tag" ]; then
    [ -n "$value" ] && [[ ! "$value" =~ [[:cntrl:]] ]] || return 1
    while IFS= read -r dev; do
      [ -b "$dev" ] || continue
      readlink -f -- "$dev"
    done < <(blkid -t "$tag=$value" -o device 2>/dev/null || true)
  else
    [ -n "$dev" ] && [ -b "$dev" ] || return 1
    readlink -f -- "$dev"
  fi | sort -u
}
backing_disks(){
  local dev
  dev=$(readlink -f -- "$1" 2>/dev/null || true)
  [ -n "$dev" ] || return 1
  # Inverse dependency order walks partition/device-mapper stacks toward the
  # physical disks.  Return every leaf: RAID/LVM roots can span more than one,
  # and protecting only the first would leave another live backing disk writable.
  lsblk -srnpo NAME,TYPE "$dev" 2>/dev/null | \
    awk '$2=="disk" { print $1 }' | sort -u
}

device_tree_busy_reason(){
  local target="$1" nodes node node_real major_minor holder_directory
  local swap_device swap_real
  nodes=$(lsblk -nrpo NAME "$target" 2>/dev/null) || {
    printf 'could not enumerate the target device tree\n'
    return 0
  }
  [ -n "$nodes" ] || {
    printf 'target device tree is empty\n'
    return 0
  }
  while IFS= read -r node; do
    node_real=$(readlink -f -- "$node" 2>/dev/null || true)
    [ -n "$node_real" ] || {
      printf 'could not canonicalize target member %s\n' "$node"
      return 0
    }
    if findmnt -rn -S "$node_real" >/dev/null 2>&1; then
      printf '%s or one of its descendants is mounted\n' "$node_real"
      return 0
    fi
    while read -r swap_device _; do
      [ "$swap_device" != Filename ] || continue
      swap_real=$(readlink -f -- "$swap_device" 2>/dev/null || true)
      if [ -n "$swap_real" ] && [ "$swap_real" = "$node_real" ]; then
        printf '%s is active swap\n' "$node_real"
        return 0
      fi
    done < /proc/swaps
    major_minor=$(lsblk -dnro MAJ:MIN "$node_real" 2>/dev/null || true)
    [ -n "$major_minor" ] || {
      printf 'could not identify target member %s\n' "$node_real"
      return 0
    }
    holder_directory="/sys/dev/block/$major_minor/holders"
    if [ -d "$holder_directory" ] && \
       find "$holder_directory" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
      printf '%s has an active device-mapper/RAID/LVM holder\n' "$node_real"
      return 0
    fi
  done <<<"$nodes"
}

secure_boot_state(){
  local -a variables=()
  local efivars_directory=${1:-/sys/firmware/efi/efivars} byte
  shopt -s nullglob
  variables=("$efivars_directory"/SecureBoot-*)
  shopt -u nullglob
  if [ "${#variables[@]}" -eq 0 ]; then
    printf 'unavailable\n'
    return 0
  fi
  [ "${#variables[@]}" -eq 1 ] || {
    printf 'invalid\n'
    return 0
  }
  if [ -L "${variables[0]}" ] || [ ! -f "${variables[0]}" ] || \
     [ "$(stat -Lc '%s' -- "${variables[0]}" 2>/dev/null || true)" != 5 ]; then
    printf 'invalid\n'
    return 0
  fi
  byte=$(od -An -t u1 -j 4 -N 1 -- "${variables[0]}" 2>/dev/null | tr -d '[:space:]')
  case "$byte" in
    0) printf 'disabled\n' ;;
    1) printf 'enabled\n' ;;
    *) printf 'invalid\n' ;;
  esac
}

validate_created_partition_layout(){
  local p1_real p2_real p1_parent p2_parent p1_kind p2_kind
  local p1_major_minor p2_major_minor p1_start_sectors p2_start_sectors
  local p1_start_bytes p2_start_bytes p1_size_bytes p2_size_bytes
  local p1_partition_type p2_partition_type post_diskseq

  [ -b "$P1" ] && [ -b "$P2" ] || return 1
  p1_real=$(readlink -f -- "$P1" 2>/dev/null || true)
  p2_real=$(readlink -f -- "$P2" 2>/dev/null || true)
  [ -n "$p1_real" ] && [ -n "$p2_real" ] && [ "$p1_real" != "$p2_real" ] || return 1
  p1_parent=$(lsblk -dnpo PKNAME "$p1_real" 2>/dev/null || true)
  p2_parent=$(lsblk -dnpo PKNAME "$p2_real" 2>/dev/null || true)
  p1_parent=$(readlink -f -- "$p1_parent" 2>/dev/null || true)
  p2_parent=$(readlink -f -- "$p2_parent" 2>/dev/null || true)
  [ "$p1_parent" = "$TARGET_DISK" ] && [ "$p2_parent" = "$TARGET_DISK" ] || return 1
  p1_kind=$(lsblk -dnro TYPE "$p1_real" 2>/dev/null || true)
  p2_kind=$(lsblk -dnro TYPE "$p2_real" 2>/dev/null || true)
  [ "$p1_kind" = part ] && [ "$p2_kind" = part ] || return 1

  p1_major_minor=$(lsblk -dnro MAJ:MIN "$p1_real" 2>/dev/null || true)
  p2_major_minor=$(lsblk -dnro MAJ:MIN "$p2_real" 2>/dev/null || true)
  [[ "$p1_major_minor" =~ ^[0-9]+:[0-9]+$ &&
     "$p2_major_minor" =~ ^[0-9]+:[0-9]+$ ]] || return 1
  p1_start_sectors=$(<"/sys/dev/block/$p1_major_minor/start") || return 1
  p2_start_sectors=$(<"/sys/dev/block/$p2_major_minor/start") || return 1
  [[ "$p1_start_sectors" =~ ^[0-9]+$ && "$p2_start_sectors" =~ ^[0-9]+$ ]] || return 1
  p1_start_bytes=$((p1_start_sectors * 512))
  p2_start_bytes=$((p2_start_sectors * 512))
  p1_size_bytes=$(blockdev --getsize64 "$p1_real" 2>/dev/null || true)
  p2_size_bytes=$(blockdev --getsize64 "$p2_real" 2>/dev/null || true)
  p1_partition_type=$(lsblk -dnro PARTTYPE "$p1_real" 2>/dev/null || true)
  p2_partition_type=$(lsblk -dnro PARTTYPE "$p2_real" 2>/dev/null || true)
  post_diskseq=$(blockdev --getdiskseq "$TARGET_DISK" 2>/dev/null || true)
  [ "$post_diskseq" = "$TARGET_DISKSEQ" ] || return 1
  securityops_valid_partition_geometry \
    "$TARGET_SIZE" "$p1_start_bytes" "$p1_size_bytes" "$p1_partition_type" \
    "$p2_start_bytes" "$p2_size_bytes" "$p2_partition_type" || return 1
  log "validated GPT: $p1_real start=$p1_start_bytes size=$p1_size_bytes type=$p1_partition_type; $p2_real start=$p2_start_bytes size=$p2_size_bytes type=$p2_partition_type"
}

target_identity_matches_snapshot(){
  local current_disk current_type current_major_minor current_sysfs current_size
  local current_diskseq current_wwn current_serial
  current_disk=$(readlink -f -- "$TARGET_DISK" 2>/dev/null || true)
  current_type=$(lsblk -dnro TYPE "$current_disk" 2>/dev/null || true)
  current_major_minor=$(lsblk -dnro MAJ:MIN "$current_disk" 2>/dev/null || true)
  current_sysfs=$(readlink -f -- "/sys/dev/block/$current_major_minor" 2>/dev/null || true)
  current_size=$(blockdev --getsize64 "$current_disk" 2>/dev/null || true)
  current_diskseq=$(blockdev --getdiskseq "$current_disk" 2>/dev/null || true)
  current_wwn=$(lsblk -dnro WWN "$current_disk" 2>/dev/null | tr -d '[:space:]')
  current_serial=$(lsblk -dnro SERIAL "$current_disk" 2>/dev/null | tr -d '[:space:]')
  [ -b "$current_disk" ] && \
    securityops_same_disk_identity \
      "$TARGET_DISK" "$TARGET_MAJMIN" "$TARGET_SYSFS" "$TARGET_SIZE" \
      "$TARGET_DISKSEQ" "$TARGET_WWN" "$TARGET_SERIAL" \
      "$current_disk" "$current_type" "$current_major_minor" \
      "$current_sysfs" "$current_size" "$current_diskseq" \
      "$current_wwn" "$current_serial"
}

require_target_identity(){
  local phase="$1"
  target_identity_matches_snapshot || \
    die "Target device identity changed before $phase. Refusing the next destructive open."
}

require_target_unclaimed_identity(){
  local phase=$1 busy_reason
  require_target_identity "$phase"
  busy_reason=$(device_tree_busy_reason "$TARGET_DISK")
  [ -z "$busy_reason" ] || \
    die "Target use changed before $phase: $busy_reason. Refusing the next destructive open."
}

