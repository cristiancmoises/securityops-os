#!/run/current-system/profile/bin/bash -p
# ============================================================================
# security-ops-install — the Security Ops OS guided installer
# ============================================================================
# A branded (black background / cyan text) ncurses (whiptail) guided installer
# for the declarative GNU Guix "Security Ops OS".  It collects the machine's
# choices, GENERATES a self-contained /mnt/etc/config.scm, partitions the disk
# (optionally LUKS-encrypted), makes the chosen filesystem, and runs
# `guix system init' to build the system onto the target.
#
# It intentionally does NOT touch any disk until you type the target device
# name to confirm.  Guix's install model is declarative: what this installer
# produces is a config.scm you keep and can `guix system reconfigure' forever.
#
#   Filesystems : ext4 · btrfs · xfs · ZFS (planned; currently disabled)
#   Encryption  : LUKS2 encrypted root volume (optional; ESP stays plaintext)
#   Desktops    : Sway (Wayland) · XMonad on XLibre (X11) · KDE Plasma
#   Kernel      : linux-securityops (version managed by securityopsctl)
#
# © Cristian Cezar Moisés · sac@securityops.co · AGPL-3.0-or-later
# ============================================================================
set -Eeuo pipefail
set +x                             # inherited `bash -x' must not trace credentials

# Bash privileged mode (`-p' in the kernel-interpreted shebang) suppresses
# imported environment functions before the first command is evaluated.  Do
# not move this protection into the script body: even `builtin' itself can be
# shadowed by an exported function before an ordinary cleanup loop runs.
# Remove any functions defined by a future trusted startup path as defense in
# depth.  In particular, `readlink' must not be replaceable before sudo re-exec.
while builtin read -r _ _ inherited_function; do
  builtin unset -f -- "$inherited_function"
done < <(builtin declare -F)
builtin unset inherited_function

# --- branding: black bg, cyan text (newt/whiptail palette) ------------------
export NEWT_COLORS='
root=,black
window=cyan,black
shadow=black,black
border=cyan,black
title=white,black
button=black,cyan
compactbutton=cyan,black
actbutton=black,cyan
checkbox=cyan,black
actcheckbox=black,cyan
entry=cyan,black
disentry=gray,black
label=cyan,black
listbox=cyan,black
actlistbox=black,cyan
sellistbox=black,cyan
actsellistbox=black,cyan
textbox=cyan,black
acttextbox=black,cyan
emptyscale=,cyan
fullscale=,cyan
helpline=cyan,black
roottext=cyan,black
'
# /run/setuid-programs (and its newer alias /run/privileged/bin) MUST come first:
# the copy of sudo in the system profile is NOT setuid, so `sudo' resolved from
# there fails with "sudo: effective uid is not 0 … nosuid".  The real setuid sudo
# lives in /run/setuid-programs, so put it ahead of the profile on PATH.
export PATH="/run/setuid-programs:/run/privileged/bin:/run/current-system/profile/bin:/run/current-system/profile/sbin"
# CRITICAL: sudo's env_reset strips TERMINFO_DIRS (even without -E), so after the
# self-elevation re-exec whiptail/slang can't find foot's (or any) terminfo and
# dies "Unknown terminal: foot" before drawing a thing.  Re-point it at the
# system profile, which ships every terminal's terminfo (foot, kitty, …).
export TERMINFO_DIRS="/run/current-system/profile/share/terminfo"
# Privileged code must not inherit loader or language search paths from the live
# user.  TERM, locale variables, and the fixed terminfo path remain available to
# the TUI; executable and module resolution comes only from immutable profiles.
unset LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GCONV_PATH LOCPATH NLSPATH \
      GUILE_LOAD_PATH GUILE_LOAD_COMPILED_PATH GUILE_EXTENSIONS_PATH \
      GUIX_PACKAGE_PATH GUIX_PROFILE GUIX_DAEMON_SOCKET GUIX_BUILD_OPTIONS \
      GUIX_LOCPATH PYTHONPATH PYTHONHOME PERL5LIB RUBYLIB NODE_PATH \
      BASH_ENV ENV CDPATH GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GNUPGHOME \
      SSL_CERT_FILE SSL_CERT_DIR CURL_CA_BUNDLE CURL_HOME \
      HTTP_PROXY HTTPS_PROXY FTP_PROXY ALL_PROXY NO_PROXY \
      http_proxy https_proxy ftp_proxy all_proxy no_proxy \
      HOME XDG_CONFIG_HOME XDG_CACHE_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_RUNTIME_DIR \
      TMPDIR TMP TEMP
# Git supports indexed GIT_CONFIG_KEY_N/GIT_CONFIG_VALUE_N variables.  Remove
# the complete prefix, not merely the common singleton names.
while IFS= read -r inherited_name; do
  unset "$inherited_name"
done < <(compgen -A variable GIT_CONFIG_)
unset inherited_name
IFS=$' \t\n'
SRC_LINK=/etc/securityops/src     # embedded (securityops …) modules, for guix -L
SRC=""
SUBSTITUTE_URLS="https://substitutes.securityops.com.br https://substitutes.securityops.co https://ci.guix.gnu.org"
PINNED_CHANNELS=""
TITLE="Security Ops OS · Installer"
RUNTIME_DIR=/run/securityops-installer
PRIVILEGED_STATE_ROOT=""
PRIVILEGED_HOME=""
PRIVILEGED_XDG_CONFIG_HOME=""
PRIVILEGED_XDG_CACHE_HOME=""
PRIVILEGED_XDG_DATA_HOME=""
PRIVILEGED_XDG_STATE_HOME=""
PRIVILEGED_XDG_RUNTIME_DIR=""
PRIVILEGED_TMPDIR=""
TRUSTED_PYTHON_LINK=/run/current-system/profile/bin/python3
TRUSTED_GUILE_LINK=/run/current-system/profile/bin/guile
TRUSTED_GUILE_SITE_LINK=/run/current-system/profile/share/guile/site/3.0
TRUSTED_GUILE_CCACHE_LINK=/run/current-system/profile/lib/guile/3.0/site-ccache
TRUSTED_GUILE_EXTENSIONS_LINK=/run/current-system/profile/lib/guile/3.0/extensions
TRUSTED_GUIX_LINK=/run/current-system/profile/bin/guix
TRUSTED_CERT_FILE_LINK=/run/current-system/profile/etc/ssl/certs/ca-certificates.crt
TRUSTED_CERT_DIR_LINK=/run/current-system/profile/etc/ssl/certs
TRUSTED_FLOCK_LINK=/run/current-system/profile/bin/flock
TRUSTED_SETSID_LINK=/run/current-system/profile/bin/setsid
TRUSTED_SWAYMSG_LINK=/run/current-system/profile/bin/swaymsg
TRUSTED_LOADKEYS_LINK=/run/current-system/profile/bin/loadkeys
TRUSTED_SYNC_LINK=/run/current-system/profile/bin/sync
LOG=""
ADMIN_HASH_FILE=""
COW_HELPER_PID=""
COW_HELPER_PGID=""
COW_HELPER_ACTIVE=0
COW_HELPER_LAUNCH_IN_PROGRESS=0
COW_PENDING_SIGNAL_STATUS=""
COW_PENDING_SIGNAL_NAME=""

FIXED_INSTALLER_LINK=/run/current-system/profile/bin/security-ops-install
securityops_pre_root_store_file(){
  local requested=${1:-} resolved relative item component metadata owner mode
  local LC_ALL=C
  resolved=$(/run/current-system/profile/bin/readlink -f -- "$requested") || return 1
  case "$resolved" in /gnu/store/*) ;; *) return 1 ;; esac
  relative=${resolved#/gnu/store/}
  item=${relative%%/*}
  [[ "$item" =~ ^[0-9abcdfghijklmnpqrsvwxyz]{32}-.+$ ]] || return 1
  [ -f "$resolved" ] && [ ! -L "$resolved" ] || return 1
  component=$resolved
  while [[ "$component" == /gnu/store/* ]]; do
    metadata=$(/run/current-system/profile/bin/stat -Lc '%u:%a' -- "$component") || return 1
    owner=${metadata%%:*}
    mode=${metadata#*:}
    [[ "$owner" == 0 && "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
    (( (8#$mode & 8#022) == 0 )) || return 1
    [ "$component" = "/gnu/store/$item" ] && break
    component=${component%/*}
  done
  [ "$component" = "/gnu/store/$item" ] || return 1
  printf '%s\n' "$resolved"
}

# The destructive workflow may only start from the exact immutable package in
# the active system profile.  Reject mutable copies before sourcing a sibling or
# requesting sudo, and repeat this complete check after the root re-exec.
INSTALLER_PATH=$(securityops_pre_root_store_file "$FIXED_INSTALLER_LINK") || {
  echo "security-ops-install: fixed profile installer is missing or mutable" >&2
  exit 1
}
INVOKED_INSTALLER=$(/run/current-system/profile/bin/readlink -f -- "$0") || {
  echo "security-ops-install: could not resolve invoked installer" >&2
  exit 1
}
if [ "$INVOKED_INSTALLER" != "$INSTALLER_PATH" ] || \
   [ "$(/run/current-system/profile/bin/readlink -f -- "$FIXED_INSTALLER_LINK")" != "$INSTALLER_PATH" ]; then
  echo "security-ops-install: run the immutable installer from the active system profile" >&2
  exit 1
fi
INSTALLER_DIR=${INSTALLER_PATH%/*}
PRIVATE_STATE_LIBRARY="$INSTALLER_DIR/private-state.sh"
CONFIG_GENERATOR="$INSTALLER_DIR/gen-config.sh"
COW_INIT_HELPER="$INSTALLER_DIR/cow-system-init.scm"
for installer_sibling in \
  "$PRIVATE_STATE_LIBRARY" "$CONFIG_GENERATOR" "$COW_INIT_HELPER"; do
  verified_sibling=$(securityops_pre_root_store_file "$installer_sibling") || {
    echo "security-ops-install: immutable installer sibling is missing or unsafe" >&2
    exit 1
  }
  if [ "$verified_sibling" != "$installer_sibling" ] || \
     [ "${verified_sibling%/*}" != "$INSTALLER_DIR" ]; then
    echo "security-ops-install: installer siblings must share one immutable package" >&2
    exit 1
  fi
done
unset INVOKED_INSTALLER verified_sibling installer_sibling
# shellcheck source=securityops/installer/private-state.sh
. "$PRIVATE_STATE_LIBRARY"

BANNER=$(cat <<'EOF'
   ____                       _ _            ___
  / ___|  ___  ___ _   _ _ __(_) |_ _   _   / _ \ _ __  ___
  \___ \ / _ \/ __| | | | '__| | __| | | | | | | | '_ \/ __|
   ___) |  __/ (__| |_| | |  | | |_| |_| | | |_| | |_) \__ \
  |____/ \___|\___|\__,_|_|  |_|\__|\__, |  \___/| .__/|___/
                                    |___/        |_|
            I N   C O D E   W E   T R U S T .
EOF
)

# Self-elevate.  Run it as the live user (no `sudo' needed) — we re-exec through
# sudo with the ABSOLUTE script path ($0 is resolved when found via PATH), which
# works regardless of sudo's secure_path, and WITHOUT `-E' (default env_reset
# would otherwise refuse `-E' and the installer would "not start").  The re-exec
# re-runs this file from the top as root, re-exporting NEWT_COLORS + PATH.
need_root(){
  [ "$EUID" -eq 0 ] && return 0
  # Use only a fixed SETUID sudo entry.  The profile copy is nosuid, and a PATH
  # lookup would let a hostile live-user directory become root after re-exec.
  local trusted_sudo
  trusted_sudo=$(securityops_trusted_setuid_sudo) || true
  [ -n "$trusted_sudo" ] && \
    exec "$trusted_sudo" -- "$INSTALLER_PATH" "$@"
  echo "security-ops-install: trusted setuid sudo entry is unavailable" >&2
  exit 1
}
need_root "$@"

ulimit -c 0 || {
  echo "security-ops-install: could not disable core dumps" >&2
  exit 1
}
INTERNAL_LOCK_HELD=0
if [[ ${1:-} == --internal-lock-held ]]; then
  INTERNAL_LOCK_HELD=1
  shift
fi

# Create all privileged runtime state only after elevation.  /run's root-owned
# parent prevents an unprivileged rename race; the helper additionally refuses
# symlinks, wrong owners, and permissive modes.  mktemp uses O_EXCL inside the
# resulting mode-0700 directory, replacing the former predictable /tmp log.
umask 077
securityops_private_directory "$RUNTIME_DIR" || {
  echo "security-ops-install: refusing unsafe private runtime directory" >&2
  exit 1
}
TRUSTED_FLOCK=$(securityops_resolve_store_path \
  "$TRUSTED_FLOCK_LINK" executable) || {
  echo "security-ops-install: trusted flock is unavailable" >&2
  exit 1
}
TRUSTED_SETSID=$(securityops_resolve_store_path \
  "$TRUSTED_SETSID_LINK" executable) || {
  echo "security-ops-install: trusted setsid is unavailable" >&2
  exit 1
}
TRUSTED_PYTHON=$(securityops_resolve_store_path \
  "$TRUSTED_PYTHON_LINK" executable) || {
  echo "security-ops-install: trusted Python is unavailable" >&2
  exit 1
}
# Serialize destructive sessions before allocating per-run state.  A dedicated
# flock supervisor owns the lock; --close prevents the installer and every
# descendant from inheriting the lock file descriptor.
LOCK_FILE="$RUNTIME_DIR/installer.lock"
if [ ! -e "$LOCK_FILE" ]; then
  set -C
  : >"$LOCK_FILE" || {
    set +C
    echo "security-ops-install: could not create private installer lock" >&2
    exit 1
  }
  set +C
fi
if [ -L "$LOCK_FILE" ] || [ ! -f "$LOCK_FILE" ] || \
   [ "$(stat -c '%u:%g:%a' -- "$LOCK_FILE")" != "0:0:600" ]; then
  echo "security-ops-install: refusing unsafe installer lock" >&2
  exit 1
fi
COW_LOCK_FILE="$RUNTIME_DIR/cow-system-init.lock"
if [ ! -e "$COW_LOCK_FILE" ]; then
  set -C
  : >"$COW_LOCK_FILE" || {
    set +C
    echo "security-ops-install: could not create private COW lifecycle lock" >&2
    exit 1
  }
  set +C
fi
if [ -L "$COW_LOCK_FILE" ] || [ ! -f "$COW_LOCK_FILE" ] || \
   [ "$(stat -c '%u:%g:%a' -- "$COW_LOCK_FILE")" != "0:0:600" ]; then
  echo "security-ops-install: refusing unsafe COW lifecycle lock" >&2
  exit 1
fi
if [ "$INTERNAL_LOCK_HELD" = 0 ]; then
  exec "$TRUSTED_FLOCK" -n -E 75 --close --verbose "$LOCK_FILE" \
    "$INSTALLER_PATH" --internal-lock-held "$@"
fi
if ! securityops_verify_flock_supervisor \
     "$LOCK_FILE" "$TRUSTED_FLOCK" "$TRUSTED_PYTHON" "$PPID"; then
  echo "security-ops-install: internal lock marker is not bound to the lock supervisor" >&2
  exit 1
fi
exec {LOCK_PROBE_FD}>>"$LOCK_FILE"
if "$TRUSTED_FLOCK" -n "$LOCK_PROBE_FD"; then
  "$TRUSTED_FLOCK" -u "$LOCK_PROBE_FD" || true
  exec {LOCK_PROBE_FD}>&-
  echo "security-ops-install: internal lock marker has no supervising lock" >&2
  exit 1
fi
exec {LOCK_PROBE_FD}>&-

IFS= read -r installer_process_status <"/proc/$$/stat" || {
  echo "security-ops-install: could not bind installer process identity" >&2
  exit 1
}
installer_process_status=${installer_process_status##*) }
read -r -a installer_process_fields <<<"$installer_process_status"
INSTALLER_START_TIME=${installer_process_fields[19]:-}
[[ "$INSTALLER_START_TIME" =~ ^[0-9]+$ ]] || {
  echo "security-ops-install: installer process start time is malformed" >&2
  exit 1
}
unset installer_process_status installer_process_fields

PRIVILEGED_STATE_ROOT=$(umask 077; mktemp -d -- "$RUNTIME_DIR/session.XXXXXX") || {
  echo "security-ops-install: could not create isolated privileged state" >&2
  exit 1
}
securityops_private_directory "$PRIVILEGED_STATE_ROOT" || {
  echo "security-ops-install: refusing unsafe privileged state root" >&2
  exit 1
}
PRIVILEGED_HOME="$PRIVILEGED_STATE_ROOT/home"
PRIVILEGED_XDG_CONFIG_HOME="$PRIVILEGED_STATE_ROOT/xdg-config"
PRIVILEGED_XDG_CACHE_HOME="$PRIVILEGED_STATE_ROOT/xdg-cache"
PRIVILEGED_XDG_DATA_HOME="$PRIVILEGED_STATE_ROOT/xdg-data"
PRIVILEGED_XDG_STATE_HOME="$PRIVILEGED_STATE_ROOT/xdg-state"
PRIVILEGED_XDG_RUNTIME_DIR="$PRIVILEGED_STATE_ROOT/xdg-runtime"
PRIVILEGED_TMPDIR="$PRIVILEGED_STATE_ROOT/tmp"
# Root tools must never consult the live user's HOME, XDG, temporary-directory,
# Git, or Guix configuration.  Each directory is empty, root-owned, mode 0700,
# and volatile; channels and substitute URLs are passed explicitly below.
for private_directory in \
  "$PRIVILEGED_HOME" "$PRIVILEGED_XDG_CONFIG_HOME" \
  "$PRIVILEGED_XDG_CACHE_HOME" "$PRIVILEGED_XDG_DATA_HOME" \
  "$PRIVILEGED_XDG_STATE_HOME" "$PRIVILEGED_XDG_RUNTIME_DIR" \
  "$PRIVILEGED_TMPDIR"; do
  securityops_private_directory "$private_directory" || {
    echo "security-ops-install: refusing unsafe privileged runtime state" >&2
    exit 1
  }
done
unset private_directory
export HOME="$PRIVILEGED_HOME"
export XDG_CONFIG_HOME="$PRIVILEGED_XDG_CONFIG_HOME"
export XDG_CACHE_HOME="$PRIVILEGED_XDG_CACHE_HOME"
export XDG_DATA_HOME="$PRIVILEGED_XDG_DATA_HOME"
export XDG_STATE_HOME="$PRIVILEGED_XDG_STATE_HOME"
export XDG_RUNTIME_DIR="$PRIVILEGED_XDG_RUNTIME_DIR"
export TMPDIR="$PRIVILEGED_TMPDIR"
LOG=$(securityops_private_tempfile "$RUNTIME_DIR" install-log) || {
  echo "security-ops-install: could not create a private installer log" >&2
  exit 1
}
log(){ echo "[$(date +%T)] $*" >>"$LOG"; }

cow_helper_pid_running(){
  local status state
  [ "$COW_HELPER_ACTIVE" = 1 ] && [ -n "$COW_HELPER_PID" ] || return 1
  [ -r "/proc/$COW_HELPER_PID/stat" ] || return 1
  IFS= read -r status <"/proc/$COW_HELPER_PID/stat" || return 1
  status=${status##*) }
  state=${status%% *}
  [ "$state" != Z ]
}

cow_helper_group_alive(){
  [ "$COW_HELPER_ACTIVE" = 1 ] && [ -n "$COW_HELPER_PGID" ] && \
    kill -0 -- "-$COW_HELPER_PGID" 2>/dev/null
}

recover_and_witness_cow_lifecycle(){
  local witness_fd attempts=100 lock_available=0
  while [ "$attempts" -gt 0 ]; do
    exec {witness_fd}>>"$COW_LOCK_FILE" || return 1
    if "$TRUSTED_FLOCK" -n "$witness_fd"; then
      "$TRUSTED_FLOCK" -u "$witness_fd" || {
        exec {witness_fd}>&-
        return 1
      }
      exec {witness_fd}>&-
      lock_available=1
      break
    fi
    exec {witness_fd}>&-
    sleep 0.1
    attempts=$((attempts - 1))
  done
  [ "$lock_available" = 1 ] || return 1
  if [ -e "$RUNTIME_DIR/cow-system-init.state" ] || \
     [ -L "$RUNTIME_DIR/cow-system-init.state" ]; then
    GUILE_EXTENSIONS_PATH="$TRUSTED_GUILE_EXTENSIONS" \
      "$TRUSTED_FLOCK" -n -E 75 --no-fork "$COW_LOCK_FILE" \
      "$TRUSTED_GUILE" -L "$TRUSTED_GUILE_SITE" -C "$TRUSTED_GUILE_CCACHE" \
      -s "$COW_INIT_HELPER" --recover-only "$$" "$INSTALLER_START_TIME" \
      "$TRUSTED_FLOCK" >>"$LOG" 2>&1 || return 1
  fi
  [ ! -e "$RUNTIME_DIR/cow-system-init.state" ] && \
    [ ! -L "$RUNTIME_DIR/cow-system-init.state" ] || return 1
  exec {witness_fd}>>"$COW_LOCK_FILE" || return 1
  if ! "$TRUSTED_FLOCK" -n "$witness_fd"; then
    exec {witness_fd}>&-
    return 1
  fi
  "$TRUSTED_FLOCK" -u "$witness_fd" || {
    exec {witness_fd}>&-
    return 1
  }
  exec {witness_fd}>&-
}

terminate_owned_cow_helper(){
  local signal_name=${1:-TERM} attempts rc=0
  [ "$COW_HELPER_ACTIVE" = 1 ] || return 0
  if cow_helper_group_alive; then
    kill -s "$signal_name" -- "-$COW_HELPER_PGID" 2>/dev/null || true
  elif cow_helper_pid_running; then
    kill -s "$signal_name" -- "$COW_HELPER_PID" 2>/dev/null || true
  fi
  attempts=600
  while cow_helper_pid_running && [ "$attempts" -gt 0 ]; do
    sleep 0.1
    attempts=$((attempts - 1))
  done
  if cow_helper_pid_running || cow_helper_group_alive; then
    log "COW helper exceeded cleanup deadline; sending SIGKILL to owned group"
    if [ -n "$COW_HELPER_PGID" ]; then
      kill -KILL -- "-$COW_HELPER_PGID" 2>/dev/null || true
    else
      kill -KILL -- "$COW_HELPER_PID" 2>/dev/null || true
    fi
  fi
  wait "$COW_HELPER_PID" 2>/dev/null || rc=$?
  # The session leader is now reaped.  Any remaining process with this PGID is
  # an escaped helper descendant and must be killed before target/private state
  # can be touched by Bash cleanup.
  attempts=100
  while cow_helper_group_alive && [ "$attempts" -gt 0 ]; do
    kill -KILL -- "-$COW_HELPER_PGID" 2>/dev/null || true
    sleep 0.1
    attempts=$((attempts - 1))
  done
  if cow_helper_group_alive; then
    log "owned COW helper group survived SIGKILL; retaining cleanup guard and runtime evidence"
    return 125
  fi
  if ! recover_and_witness_cow_lifecycle; then
    log "COW lifecycle has no authenticated completion witness; retaining cleanup guard"
    return 125
  fi
  COW_HELPER_ACTIVE=0
  COW_HELPER_PID=""
  COW_HELPER_PGID=""
  return "$rc"
}

wait_owned_cow_helper(){
  local rc=0 attempts
  [ "$COW_HELPER_ACTIVE" = 1 ] || return 125
  wait "$COW_HELPER_PID" || rc=$?
  attempts=600
  while cow_helper_group_alive && [ "$attempts" -gt 0 ]; do
    kill -TERM -- "-$COW_HELPER_PGID" 2>/dev/null || true
    sleep 0.1
    attempts=$((attempts - 1))
  done
  if cow_helper_group_alive; then
    kill -KILL -- "-$COW_HELPER_PGID" 2>/dev/null || true
    attempts=100
    while cow_helper_group_alive && [ "$attempts" -gt 0 ]; do
      sleep 0.1
      attempts=$((attempts - 1))
    done
  fi
  if cow_helper_group_alive; then
    log "owned COW helper left a live descendant process group"
    return 125
  fi
  if ! recover_and_witness_cow_lifecycle; then
    log "COW helper exited without a recoverable completion witness"
    return 125
  fi
  COW_HELPER_ACTIVE=0
  COW_HELPER_PID=""
  COW_HELPER_PGID=""
  return "$rc"
}

cleanup_private_state(){
  if [ "$COW_HELPER_ACTIVE" = 1 ]; then
    log "refusing private-state cleanup while the COW helper is active"
    return 1
  fi
  unset UPASS UPASS2 LPASS LPASS2
  if [[ -n ${ADMIN_HASH_FILE:-} ]]; then
    case "$ADMIN_HASH_FILE" in
      "$RUNTIME_DIR"/admin-hash.*) rm -f -- "$ADMIN_HASH_FILE" ;;
      *) log "refusing unexpected admin-hash cleanup path" ;;
    esac
    ADMIN_HASH_FILE=""
  fi
  if [[ -n ${PRIVILEGED_STATE_ROOT:-} ]]; then
    case "$PRIVILEGED_STATE_ROOT" in
      "$RUNTIME_DIR"/session.*)
        if securityops_private_directory "$PRIVILEGED_STATE_ROOT"; then
          rm -rf --one-file-system -- "$PRIVILEGED_STATE_ROOT"
        else
          log "refusing unsafe privileged-state cleanup path"
        fi ;;
      *) log "refusing unexpected privileged-state cleanup path" ;;
    esac
    PRIVILEGED_STATE_ROOT=""
  fi
}

WIPED=0                       # set to 1 the instant we start modifying the disk
TARGET_MOUNTED=0              # only this run may unmount /mnt
CRYPTROOT_OPENED=0            # only this run may close cryptroot
TARGET_MOUNT_ATTEMPTED=0
CRYPTROOT_OPEN_ATTEMPTED=0
EXPECTED_ROOTDEV_MAJMIN=""
EXPECTED_CRYPT_SOURCE=""

cleanup_target_state(){
  local failed=0
  local mounted_major_minor crypt_source
  if [ "$TARGET_MOUNT_ATTEMPTED" = 1 ] || [ "$TARGET_MOUNTED" = 1 ]; then
    mounted_major_minor=$(findmnt -nro MAJ:MIN -M /mnt 2>/dev/null || true)
    if [ -z "$mounted_major_minor" ]; then
      TARGET_MOUNT_ATTEMPTED=0
      TARGET_MOUNTED=0
    elif [ -n "$EXPECTED_ROOTDEV_MAJMIN" ] && \
         [ "$mounted_major_minor" = "$EXPECTED_ROOTDEV_MAJMIN" ] && \
         target_identity_matches_snapshot && validate_created_partition_layout; then
      if umount -R /mnt >>"$LOG" 2>&1; then
        TARGET_MOUNT_ATTEMPTED=0
        TARGET_MOUNTED=0
      else
        log "failed to unmount installer-owned /mnt"
        failed=1
      fi
    else
      log "refusing to unmount /mnt: mounted device identity is not installer-owned"
      failed=1
    fi
  fi
  if [ "$CRYPTROOT_OPEN_ATTEMPTED" = 1 ] || [ "$CRYPTROOT_OPENED" = 1 ]; then
    if ! cryptsetup status cryptroot >/dev/null 2>&1; then
      CRYPTROOT_OPEN_ATTEMPTED=0
      CRYPTROOT_OPENED=0
    else
      crypt_source=$(LC_ALL=C cryptsetup status cryptroot 2>/dev/null | \
        awk '$1 == "device:" { print $2; exit }')
      crypt_source=$(readlink -f -- "$crypt_source" 2>/dev/null || true)
      if [ -n "$EXPECTED_CRYPT_SOURCE" ] && \
         [ "$crypt_source" = "$EXPECTED_CRYPT_SOURCE" ] && \
         [ -n "${LUKS_UUID:-}" ] && \
         [ "$(cryptsetup luksUUID "$crypt_source" 2>/dev/null || true)" = "$LUKS_UUID" ] && \
         target_identity_matches_snapshot && validate_created_partition_layout; then
        if cryptsetup close cryptroot >>"$LOG" 2>&1; then
          CRYPTROOT_OPEN_ATTEMPTED=0
          CRYPTROOT_OPENED=0
        else
          log "failed to close installer-owned cryptroot"
          failed=1
        fi
      else
        log "refusing to close cryptroot: backing device is not installer-owned"
        failed=1
      fi
    fi
  fi
  return "$failed"
}

cleanup_all(){
  if [ "$COW_HELPER_ACTIVE" = 1 ]; then
    terminate_owned_cow_helper TERM || true
  fi
  if [ "$COW_HELPER_ACTIVE" = 1 ]; then
    log "refusing target/private cleanup while an owned COW descendant survives"
    return 1
  fi
  cleanup_target_state || true
  cleanup_private_state || true
}

die(){ trap - ERR; whiptail --title "$TITLE — ERROR" --msgbox "$1\n\nSee $LOG" 16 76; exit 1; }
on_err(){
  trap - ERR
  if [ "$COW_HELPER_ACTIVE" = 1 ]; then
    terminate_owned_cow_helper TERM || true
  fi
  if [ "$COW_HELPER_ACTIVE" = 1 ]; then
    die "The COW helper did not terminate; target/private cleanup is blocked. Do not reuse the target until recovery diagnostics complete."
  fi
  if [ "$WIPED" = 1 ]; then
    cleanup_target_state || true
    die "Installer aborted on error (line $1). The target disk was PARTIALLY
MODIFIED. Installer-owned mounts/mappings were cleaned where possible; inspect
the private log before retrying."
  else
    die "Installer aborted on error (line $1). No disk was modified."
  fi
}
on_signal(){
  local status=$1 signal_name=$2
  # Bash delivers traps only between complete commands, but a signal can still
  # arrive after the async helper exists and before `$!' is captured.  Latch it
  # until the helper PID/PGID is authenticated; cleanup must never mistake that
  # launch window for proof that no helper exists.
  if [ "$COW_HELPER_LAUNCH_IN_PROGRESS" = 1 ]; then
    if [ -z "$COW_PENDING_SIGNAL_STATUS" ]; then
      COW_PENDING_SIGNAL_STATUS=$status
      COW_PENDING_SIGNAL_NAME=$signal_name
    fi
    log "latched $signal_name during COW helper launch authentication"
    return 0
  fi
  trap - ERR HUP INT TERM QUIT
  log "interrupted by $signal_name"
  if [ "$COW_HELPER_ACTIVE" = 1 ]; then
    terminate_owned_cow_helper "$signal_name" || true
  fi
  if [ "$COW_HELPER_ACTIVE" = 1 ]; then
    log "signal cleanup blocked because owned COW descendants survived"
    exit 125
  fi
  if [ "$WIPED" = 1 ]; then
    cleanup_target_state || true
  fi
  exit "$status"
}
