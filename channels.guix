;; CodeMark v1 project=4c63e0fe-589c-4944-8449-97e211a38b72 file=6626489ebfc5589aaea08a8d53b2f51d owner="Cristian Cezar Mois\u00e9s"
;; channels.guix — channels for a reproducible Security Ops live build.
;;
;; This is the maintainer's full working channel graph, reproduced at the
;; exact revisions of the workstation `guix describe` generation that builds
;; the v1.14.0 image:
;;   guix, nonguix, radix, rosenthal, small-guix, securityops, gocix,
;;   sops-guix.
;; XLibre is provided by the securityops channel itself; the separate
;; guix-xlibre channel is retired.
;;
;; Build reproducibly with:
;;   ./build.sh --pinned
;;
;; Every channel is commit-pinned and authenticated where the channel
;; publishes an introduction.  The image and build wrapper use Security Ops
;; as the first substitute and GNU Guix CI as the second; channel Git
;; repositories remain source inputs.

(list
 (channel
  (name 'guix)
  ;; Authenticated mirror of the Savannah repository kept in the
  ;; maintainer's primary Forgejo namespace; the introduction and pinned
  ;; commit still authenticate the channel contents.
  (url "https://git.securityops.com.br/cristiancmoises/guix.git")
  (branch "master")
  (commit "505ade83fc62b438c558653dd57f7fb3b197cc8f")
  (introduction
   (make-channel-introduction
    "9edb3f66fd807b096b48283debdcddccfea34bad"
    (openpgp-fingerprint
     "BBB0 2DDF 2CEA F6A8 0D1D  E643 A2A0 6DF2 A33A 54FA"))))

