;; CodeMark v1 project=4c63e0fe-589c-4944-8449-97e211a38b72 file=d211486acfaf55b89e39cc7bb59dd5e2 owner="Cristian Cezar Mois\u00e9s"
;;; Read actual forms; evaluate only the pure policy expressions. Not an OS boot.
(use-modules (securityops hardening) (gnu services sysctl)
             (guix gexp) (guix store) (guix derivations)
             (srfi srfi-1) (ice-9 match) (ice-9 textual-ports))

(define (assert value message) (unless value (error message)))
(define (forms file)
  (call-with-input-file file
    (lambda (port)
      (let loop ((result '()))
        (let ((form (read port)))
          (if (eof-object? form) (reverse result) (loop (cons form result))))))))
(define (tagged tag tree)
  (if (pair? tree)
      (append (if (eq? tag (car tree)) (list tree) '())
              (tagged tag (car tree)) (tagged tag (cdr tree)))
      '()))
(define (definition name source)
  (let ((matches (filter (lambda (form)
                           (and (pair? form) (eq? 'define (car form))
                                (eq? name (cadr form)))) source)))
    (assert (= 1 (length matches)) "missing/duplicate policy definition")
    (caddar matches)))
(define (evaluate form) (eval form (current-module)))
(define (check-args args)
  (for-each
   (lambda (expected)
     (let* ((key (car (string-split expected #\=)))
            (values (filter (lambda (arg)
                              (string=? key (car (string-split arg #\=)))) args)))
       (assert (equal? values (list expected)) "missing/conflicting hardening argument")))
   '("mitigations=auto" "init_on_alloc=1" "slab_nomerge" "page_alloc.shuffle=1"
     "randomize_kstack_offset=on" "vsyscall=none" "lsm=landlock,yama,bpf"
     "intel_iommu=on" "iommu.passthrough=0" "iommu.strict=1"))
  (assert (not (any (lambda (arg)
                     (or (string-prefix? "iommu=" arg)
                         (string-prefix? "amd_iommu=" arg))) args))
          "legacy IOMMU override"))

(define defaults
  (append '(("kernel.kptr_restrict" . "0") ("kernel.kptr_restrict" . "1")
            ("net.ipv6.conf.all.accept_source_route" . "0")
            ("unrelated.fixture" . "preserved")) %default-sysctl-settings))
(define (sysctl-configuration-settings _) defaults)
(define config #f)
(define (check-sysctls settings)
  (for-each (lambda (entry)
              (assert (equal? (filter (lambda (other) (equal? (car other) (car entry)))
                                      settings) (list entry))
                      "missing/duplicate/overridden sysctl"))
            %securityops-hardening-sysctls)
  (for-each (lambda (entry)
              (assert (equal? (assoc (car entry) settings) entry) "critical value drift"))
            '(("fs.suid_dumpable" . "0") ("fs.protected_regular" . "2")
              ("fs.protected_fifos" . "2") ("kernel.kexec_load_disabled" . "1")
              ("kernel.perf_event_paranoid" . "3")
              ("net.ipv4.conf.all.rp_filter" . "2")
              ("net.ipv4.conf.default.rp_filter" . "2")
              ("net.ipv6.conf.all.accept_source_route" . "-1")
              ("net.ipv6.conf.default.accept_source_route" . "-1")
              ("unrelated.fixture" . "preserved")))
  (for-each (lambda (scope)
              (for-each (lambda (knob)
                          (assert (equal? (assoc-ref settings
                                         (string-append "net.ipv4.conf." scope "." knob)) "0")
                                  "missing IPv4 per-interface policy"))
                        '("accept_redirects" "send_redirects" "secure_redirects" "accept_source_route")))
            '("all" "default"))
  ;; Use Guix's real serializer, not a reimplementation or host sysctl writes.
  (let* ((file ((@@ (gnu services sysctl) sysctl-configuration-settings->sysctl.conf) settings))
         (text (with-store store
                 (let ((drv (run-with-store store (lower-object file))))
                   (assert (build-derivations store (list drv)) "sysctl file build failed")
                   (call-with-input-file (derivation->output-path drv) get-string-all)))))
    (assert (string-contains text "fs.suid_dumpable=0\n") "serialization failed")
    (assert (string-contains text "net.ipv6.conf.default.accept_source_route=-1\n")
            "IPv6 serialization failed")))

(define live (forms (cadr (command-line))))
(assert (member '(securityops hardening) (cdar (tagged 'use-modules live)))
        "live module import missing")
(define %securityops-sysctl (evaluate (definition '%securityops-sysctl live)))
(define base (evaluate (definition '%base-kernel-arguments live)))
(check-args base)
(define (live-entry _ extras) (append base extras))
(define variants (evaluate (definition '%boot-menu-entries live)))
(assert (= 4 (length variants)) "boot variants missing")
(for-each check-args variants)
(define (check-service source)
  (let ((services (tagged 'sysctl-service-type source)))
    (assert (= 1 (length services)) "sysctl service missing/duplicated")
    (let ((settings (tagged 'settings (car services))))
      (assert (= 1 (length settings)) "sysctl settings ambiguous")
      (check-sysctls (evaluate (cadar settings))))))
(check-service live)
(for-each
 (lambda (file)
   (let* ((source (forms file)) (args (tagged 'kernel-arguments source)))
     (assert (member '(securityops hardening) (cdar (tagged 'use-modules source)))
             "installed module import missing")
     (assert (= 1 (length args)) "installed kernel arguments missing")
     (check-args (evaluate (cadar args)))
     (check-service source)))
 (cddr (command-line)))
(format #t "policy expressions verified: live + ~a generated~%"
        (length (cddr (command-line))))
