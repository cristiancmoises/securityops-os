        settings["release"]["build_revision"],
        settings["release"]["desktop_label"],
    ))
    print("  kernel: Linux {}".format(settings["kernel"]["version"]))
    print("  package overrides: +{} / -{}".format(
        len(settings["packages"]["add"]), len(settings["packages"]["remove"])
    ))
    print("  ISO build: {}".format(probe_build_lock(repository)))
    disk_target = repository.out_dir if repository.out_dir.exists() else repository.root
    usage = shutil.disk_usage(disk_target)
    print("  disk free: {}".format(human_bytes(usage.free)))
