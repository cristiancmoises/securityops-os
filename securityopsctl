def _ensure_build_request_consistent(args: argparse.Namespace) -> None:
    if not getattr(args, "build", False):
        requested = any(
            getattr(args, name, None)
            for name in ("bundle", "prune_old", "jobs", "cores")
        )
        if requested:
            raise ValidationError("--bundle/--prune-old/--jobs/--cores require --build")


def _mutation_build_options(args: argparse.Namespace) -> Dict[str, Any]:
    _ensure_build_request_consistent(args)
    return {
        "bundle": args.bundle,
        "prune_old": args.prune_old,
        "jobs": args.jobs,
        "cores": args.cores,
        "dry_run": args.dry_run,
    }


def mutate_and_optionally_build(
    args: argparse.Namespace,
    repository: Repository,
    transform: Callable[[Dict[str, Any]], None],
    runner: Callable[..., subprocess.CompletedProcess[Any]] = subprocess.run,
) -> int:
    options = _mutation_build_options(args)
    build_requested = bool(getattr(args, "build", False))
    if build_requested and not args.dry_run and not _builder_has_lock_handoff(repository):
        raise MaintainerError(
            "make-iso.sh does not support the inherited-lock protocol; "
            "settings and build were left untouched"
        )
    with BuildLock(repository) as lock:
        changed, _settings = _mutate_settings_locked(
            repository, transform, args.dry_run
        )
        if not build_requested:
            return 0
        result = run_build(repository, held_lock=lock, runner=runner, **options)
        if result != 0 and not args.dry_run:
            print(
                "error: ISO build failed with exit {}; the intended settings{} "
                "remain recorded in {}".format(
                    result,
                    " change" if changed else "",
                    repository.settings_path,
                ),
                file=sys.stderr,
            )
        return result


def handle_package_mutation(
    args: argparse.Namespace, repository: Repository, action: str
) -> int:
    packages = args.packages
    additions = packages if action == "add" else ()
    removals = packages if action == "remove" else ()
    resets = packages if action == "reset" else ()
    return mutate_and_optionally_build(
        args,
        repository,
        lambda data: update_package_overrides(data, additions, removals, resets),
    )


def handle_kernel_set(args: argparse.Namespace, repository: Repository) -> int:
    metadata = fetch_kernel_metadata(args.version, repository)
    return mutate_and_optionally_build(
        args, repository, lambda data: set_kernel(data, metadata)
    )


def handle_release_set(args: argparse.Namespace, repository: Repository) -> int:
    return mutate_and_optionally_build(
        args,
        repository,
        lambda data: set_release(
            data, args.version, args.revision, args.desktop_label
        ),
    )


def handle_apply(args: argparse.Namespace, repository: Repository) -> int:
    additions = args.add or []
    removals = args.remove or []
    resets = args.reset or []
    if not any((additions, removals, resets, args.kernel, args.build)):
        raise ValidationError("apply needs a package action, --kernel, or --build")
    for package in additions:
        validate_package_specification(package)
    for package in removals + resets:
        validate_package_name(package)
    addition_bases = {package_spec_base(package) for package in additions}
    conflicts = (addition_bases & set(removals)) | (addition_bases & set(resets)) | (
        set(removals) & set(resets)
    )
    if conflicts:
        raise ValidationError(
            "the same package cannot have multiple actions: {}".format(
                ", ".join(sorted(conflicts))
            )
        )
    metadata = fetch_kernel_metadata(args.kernel, repository) if args.kernel else None
    if any((additions, removals, resets, metadata)):
        def transform(data: Dict[str, Any]) -> None:
            update_package_overrides(data, additions, removals, resets)
            if metadata is not None:
                set_kernel(data, metadata)

        return mutate_and_optionally_build(args, repository, transform)
    _ensure_build_request_consistent(args)
    return run_build(
        repository,
        bundle=args.bundle,
        prune_old=args.prune_old,
        jobs=args.jobs,
        cores=args.cores,
        dry_run=args.dry_run,
    )


def add_build_flags(parser: argparse.ArgumentParser, with_trigger: bool) -> None:
    if with_trigger:
        parser.add_argument("--build", action="store_true", help="build after the change")
    parser.add_argument("--bundle", action="store_true", help="create verified release parts")
    parser.add_argument(
        "--prune-old", action="store_true", help="prune older local artifacts after success"
    )
    parser.add_argument("--jobs", type=positive_integer, help="maximum concurrent Guix jobs")
    parser.add_argument("--cores", type=positive_integer, help="cores available to each build")


def add_mutation_flags(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--dry-run", action="store_true", help="show changes without writing/building")
    add_build_flags(parser, with_trigger=True)


def create_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="securityopsctl",
        description="Safely maintain releases, packages, Linux, and Security Ops OS ISO builds.",
    )
    parser.add_argument("--version", action="version", version="%(prog)s {}".format(TOOL_VERSION))
    commands = parser.add_subparsers(dest="command")

    commands.add_parser("status", help="show settings, build-lock, disk, and ISO status")
    commands.add_parser("doctor", help="check build prerequisites and integration")

    package = commands.add_parser("package", help="maintain package overrides")
    package_commands = package.add_subparsers(dest="package_command", required=True)
    package_commands.add_parser("changes", help="show package additions and removals")
    for action in ("add", "remove", "reset"):
        action_parser = package_commands.add_parser(action, help="{} package overrides".format(action))
        package_help = (
            "Guix specification: name[@version][:output]"
            if action == "add"
            else "base Guix package name"
        )
        action_parser.add_argument("packages", nargs="+", help=package_help)
        add_mutation_flags(action_parser)

    kernel = commands.add_parser("kernel", help="inspect or update Linux")
    kernel_commands = kernel.add_subparsers(dest="kernel_command", required=True)
    kernel_commands.add_parser("show", help="show pinned Linux source metadata")
    kernel_set = kernel_commands.add_parser("set", help="pin an official stable Linux release")
    kernel_set.add_argument("version", help="stable version, for example 7.1.8")
    add_mutation_flags(kernel_set)

    release = commands.add_parser("release", help="inspect or update release metadata")
    release_commands = release.add_subparsers(dest="release_command", required=True)
    release_commands.add_parser("show", help="show version, revision, and desktop label")
    release_set = release_commands.add_parser("set", help="set release identity atomically")
    release_set.add_argument("version", help="stable release version, for example 1.13.0")
    release_set.add_argument(
        "--revision", required=True, help="build revision, for example r11"
    )
    release_set.add_argument(
        "--desktop-label", help="desktop label; preserve the current label when omitted"
    )
    add_mutation_flags(release_set)

    apply_parser = commands.add_parser(
        "apply", help="atomically apply package and kernel changes once"
    )
    apply_parser.add_argument("--add", nargs="+", action="extend", metavar="PACKAGE")
    apply_parser.add_argument("--remove", nargs="+", action="extend", metavar="PACKAGE")
    apply_parser.add_argument("--reset", nargs="+", action="extend", metavar="PACKAGE")
    apply_parser.add_argument("--kernel", metavar="X.Y.Z")
    apply_parser.add_argument("--dry-run", action="store_true")
    add_build_flags(apply_parser, with_trigger=True)

    validate_parser = commands.add_parser(
        "validate", help="validate settings and the Guile/Guix integration"
    )
    validate_parser.add_argument(
        "--full",
        action="store_true",
        help="run pinned kernel, live-image, and generated-installer Guix dry-runs",
    )

    build_parser = commands.add_parser("build", help="delegate a pinned ISO build to make-iso.sh")
    build_parser.add_argument("--dry-run", action="store_true", help="show invocation only")
    add_build_flags(build_parser, with_trigger=False)
    return parser


def _yes_no(prompt: str) -> bool:
    return input(prompt).strip().lower() in ("y", "yes")


def interactive_menu(repository: Repository) -> int:
    if not sys.stdin.isatty():
        create_parser().print_help()
        return 2
    menu = """
Security Ops OS Maintainer
  1. Status
  2. Doctor
  3. Show package changes
  4. Add packages
  5. Remove packages
  6. Reset package overrides
  7. Show kernel
  8. Set kernel
  9. Show release metadata
 10. Set release metadata
 11. Validate
 12. Build ISO
  0. Exit
"""
    while True:
        print(menu)
        try:
            choice = input("Select: ").strip()
            if choice == "0":
                return 0
            if choice == "1":
                show_status(repository)
            elif choice == "2":
                doctor(repository)
            elif choice == "3":
                show_package_changes(repository)
            elif choice in ("4", "5", "6"):
                packages = shlex.split(input("Package name(s): "))
                if not packages:
                    print("No packages entered.")
                    continue
                action = {"4": "add", "5": "remove", "6": "reset"}[choice]
                mutate_settings(
                    repository,
                    lambda data, selected=packages, operation=action: update_package_overrides(
                        data,
                        selected if operation == "add" else (),
                        selected if operation == "remove" else (),
                        selected if operation == "reset" else (),
                    ),
                )
            elif choice == "7":
                show_kernel(repository)
            elif choice == "8":
                version = input("Stable Linux version (X.Y.Z): ").strip()
                metadata = fetch_kernel_metadata(version, repository)
                mutate_settings(repository, lambda data: set_kernel(data, metadata))
            elif choice == "9":
                show_release(repository)
            elif choice == "10":
                version = input("Release version (X.Y.Z): ").strip()
                revision = input("Build revision (for example r11): ").strip()
                label = input("Desktop label (blank keeps current): ").strip() or None
                mutate_settings(
                    repository,
                    lambda data: set_release(data, version, revision, label),
                )
            elif choice == "11":
                validate_repository(repository)
            elif choice == "12":
                bundle = _yes_no("Create release bundle too? [y/N] ")
                prune = _yes_no("Prune older local artifacts after success? [y/N] ")
                if _yes_no("Start the pinned ISO build now? [y/N] "):
                    return run_build(repository, bundle=bundle, prune_old=prune)
            else:
                print("Unknown selection.")
        except MaintainerError as error:
            print("error: {}".format(error), file=sys.stderr)
        except (EOFError, KeyboardInterrupt):
            print()
            return 130


def dispatch(args: argparse.Namespace, repository: Repository) -> int:
    if args.command == "status":
        return show_status(repository)
    if args.command == "doctor":
        return doctor(repository)
    if args.command == "package":
        if args.package_command == "changes":
            return show_package_changes(repository)
        return handle_package_mutation(args, repository, args.package_command)
    if args.command == "kernel":
        if args.kernel_command == "show":
            return show_kernel(repository)
        return handle_kernel_set(args, repository)
    if args.command == "release":
        if args.release_command == "show":
            return show_release(repository)
        return handle_release_set(args, repository)
    if args.command == "apply":
        return handle_apply(args, repository)
    if args.command == "validate":
        return validate_repository(repository, full=args.full)
    if args.command == "build":
        return run_build(
            repository,
            bundle=args.bundle,
            prune_old=args.prune_old,
            jobs=args.jobs,
            cores=args.cores,
            dry_run=args.dry_run,
        )
    raise MaintainerError("unknown command")


def main(argv: Optional[Sequence[str]] = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    if not arguments:
        return interactive_menu(REPOSITORY)
    parser = create_parser()
    args = parser.parse_args(arguments)
    try:
        return dispatch(args, REPOSITORY)
    except MaintainerError as error:
        print("error: {}".format(error), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
