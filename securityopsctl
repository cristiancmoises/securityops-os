class MaintainerError(Exception):
    """Expected operator-facing failure."""


class ValidationError(MaintainerError):
    """Settings or input failed validation."""


class BuildBusyError(MaintainerError):
    """The ISO build lock is already held."""


@dataclass(frozen=True)
class Repository:
    root: Path

    @property
    def settings_path(self) -> Path:
        return self.root / "securityops" / "settings.json"

    @property
    def settings_module_path(self) -> Path:
        return self.root / "securityops" / "settings.scm"

    @property
    def out_dir(self) -> Path:
        return self.root / "out"

    @property
    def lock_path(self) -> Path:
        return self.out_dir / ".iso-build.lock"

    @property
    def build_script(self) -> Path:
        return self.root / "make-iso.sh"

    @property
    def channels_path(self) -> Path:
        return self.root / "channels.scm"


