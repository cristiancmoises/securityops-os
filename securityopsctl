        print("  latest ISO: {} ({})".format(image, human_bytes(image.stat().st_size)))
        print("  checksum sidecar: {}".format("present" if sidecar.is_file() else "missing"))
    return 0


def _integration_state(repository: Repository) -> List[str]:
    warnings: List[str] = []
    checks = (
        (repository.root / "config.scm", "(securityops settings)", "config.scm"),
        (repository.root / "securityops" / "kernel.scm", "(securityops settings)", "kernel.scm"),
        (repository.root / "securityops" / "sessions.scm", "(securityops settings)", "sessions.scm"),
        (
            repository.root / "securityops" / "installer" / "gen-config.sh",
            "(securityops settings)",
            "installer config generator",
        ),
    )
    for path, marker, label in checks:
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            warnings.append("cannot inspect {} integration".format(label))
            continue
        if marker not in text:
            warnings.append("{} does not yet import (securityops settings)".format(label))
    if not _builder_has_lock_handoff(repository):
        warnings.append(
            "make-iso.sh does not yet consume {} and {} for atomic "
            "mutation-to-build handoff".format(
                LOCK_HELD_ENV, LOCK_FD_ENV
            )
        )
    return warnings


def doctor(repository: Repository) -> int:
    errors: List[str] = []
    warnings: List[str] = []
    try:
        settings = load_settings(repository.settings_path)
        print("ok: settings schema {} ({})".format(
            settings["schema"], repository.settings_path
        ))
    except MaintainerError as error:
        errors.append(str(error))

    required_commands = (
        "python3", "bash", "guile", "guix", "git", "flock", "openssl",
        "sed", "readlink", "sha256sum", "split", "cmp", "find",
    )
    for command in required_commands:
        location = shutil.which(command)
        if location:
            print("ok: {} -> {}".format(command, location))
        else:
            errors.append("required command not found: {}".format(command))

    required_files = (
        repository.settings_module_path,
        repository.build_script,
        repository.channels_path,
        repository.root / "substitutes.securityops.com.br.pub",
        repository.root / "ci.guix.gnu.org.pub",
    )
    for path in required_files:
        if path.is_file() and not path.is_symlink():
            print("ok: {}".format(path.relative_to(repository.root)))
        else:
            errors.append("missing or unsafe required file: {}".format(path))

    for relative_name, (expected_hash, expected_q) in KEY_INTEGRITY.items():
        key_path = repository.root / relative_name
        if not key_path.is_file() or key_path.is_symlink():
            continue
        try:
            actual_hash = _sha256_file(key_path)
            key_text = key_path.read_text(encoding="utf-8").upper()
        except (MaintainerError, OSError, UnicodeError) as error:
            errors.append("could not verify {}: {}".format(relative_name, error))
            continue
        if actual_hash != expected_hash:
            errors.append(
                "{} SHA-256 mismatch (expected {}, got {})".format(
                    relative_name, expected_hash, actual_hash
                )
            )
        elif expected_q not in key_text:
            errors.append("{} does not contain the expected Ed25519 q value".format(relative_name))
        else:
            print("ok: {} integrity {}".format(relative_name, actual_hash))

    host_acl = Path("/etc/guix/acl")
    try:
        acl_text = host_acl.read_text(encoding="utf-8").upper()
    except (OSError, UnicodeError) as error:
        warnings.append("cannot inspect host Guix ACL {}: {}".format(host_acl, error))
    else:
        if CI_CACHE_Q in acl_text:
            print("ok: host Guix ACL trusts ci.guix.gnu.org ({})".format(CI_CACHE_Q))
        else:
            warnings.append(
                "host Guix ACL does not contain ci.guix.gnu.org q #{}#".format(CI_CACHE_Q)
            )
        if PRIVATE_CACHE_Q in acl_text:
            print("ok: host Guix ACL trusts substitutes.securityops.com.br ({})".format(
                PRIVATE_CACHE_Q
            ))
        else:
            warnings.append(
                "host Guix ACL is missing private cache q #{}#; authorize "
                "it for private-cache hits with: sudo guix archive --authorize < "
                "substitutes.securityops.com.br.pub".format(
                    PRIVATE_CACHE_Q
                )
            )

    try:
        free = shutil.disk_usage(repository.root).free
        print("ok: disk free {}".format(human_bytes(free)))
        if free < 24 * 1024**3:
            warnings.append("less than 24 GiB is free; an ISO plus release bundle may not fit")
    except OSError as error:
        warnings.append("could not determine free disk space: {}".format(error))

    warnings.extend(_integration_state(repository))
    for warning in warnings:
        print("warning: {}".format(warning), file=sys.stderr)
    for error in errors:
        print("error: {}".format(error), file=sys.stderr)
    if errors:
        print("Doctor found {} error(s) and {} warning(s).".format(
            len(errors), len(warnings)
        ))
        return 1
    print("Doctor passed with {} warning(s).".format(len(warnings)))
    return 0


def generate_installer_validation_config(
    repository: Repository,
    output_directory: Path,
    runner: Callable[..., subprocess.CompletedProcess[Any]] = subprocess.run,
) -> Path:
    generator = repository.root / "securityops" / "installer" / "gen-config.sh"
    descriptor = _open_regular_nofollow(generator)
    os.close(descriptor)
    bash = shutil.which("bash")
    if not bash:
        raise MaintainerError("bash is required to validate the installer template")
    output = output_directory / "installer-config.scm"
    command = [
        bash,
        str(generator),
        "--out",
        str(output),
        "--host",
        "securityops-validation",
        "--user",
        "validator",
        "--fullname",
        "Validation User",
        "--locale",
        "en_US.UTF-8",
        "--tz",
        "Etc/UTC",
        "--keymap",
        "us",
        "--xkbvariant",
        "",
        "--fs",
        "ext4",
        "--encrypt",
        "no",
        "--root-uuid",
        "11111111-2222-3333-4444-555555555555",
        "--efi-uuid",
        "ABCD-1234",
        "--desktop",
        "sway",
    ]
    environment = os.environ.copy()
    environment["SO_UPASS"] = "validation-user-password"
    environment["SO_RPASS"] = "validation-root-password"
    completed = runner(
        command,
        cwd=str(repository.root),
        env=environment,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if completed.returncode != 0:
        details = completed.stderr.strip().splitlines()
        suffix = ": {}".format(details[-1]) if details else ""
        raise ValidationError("installer config generation failed{}".format(suffix))
    if not output.is_file() or output.is_symlink():
        raise ValidationError("installer config generator did not create a safe output file")

    generated = output.read_text(encoding="utf-8")
    if "(local-file %pinned-channels-source)" not in generated:
        raise ValidationError("generated installer config has an unexpected channel reference")
    return output


def full_validation_commands(
    repository: Repository,
    guix: str,
    installer_config: Optional[Path] = None,
) -> List[List[str]]:
    outer = [
        guix,
        "time-machine",
        "-C",
        str(repository.channels_path),
        "--substitute-urls={}".format(SUBSTITUTE_URLS),
        "--fallback",
        "--",
    ]
    inner_common = [
        "--dry-run",
        "-L",
        str(repository.root),
        "--substitute-urls={}".format(SUBSTITUTE_URLS),
        "--fallback",
    ]
    kernel_command = outer + [
        "build",
        *inner_common,
        "-e",
        "(@ (securityops kernel) linux-securityops)",
    ]
    image_command = outer + [
        "system",
        "image",
        *inner_common,
        "-t",
        "iso9660",
        "--label=SECURITY_OPS_LIVE",
        str(repository.root / "config.scm"),
    ]
    commands = [kernel_command, image_command]
    if installer_config is not None:
        commands.append(outer + ["system", "build", *inner_common, str(installer_config)])
    return commands


def validate_repository(repository: Repository, full: bool = False) -> int:
    settings = load_settings(repository.settings_path)
    module_descriptor = _open_regular_nofollow(repository.settings_module_path)
    try:
        if os.fstat(module_descriptor).st_size > 1024 * 1024:
            raise ValidationError("settings.scm is unexpectedly larger than 1 MiB")
        try:
            module_text = os.read(module_descriptor, 1024 * 1024).decode("utf-8")
        except UnicodeDecodeError as error:
            raise ValidationError("settings.scm is not valid UTF-8") from error
    finally:
        os.close(module_descriptor)
    exports = (
        "%release-version", "%build-revision", "%desktop-label",
        "%kernel-version", "%kernel-url", "%kernel-nix-base32",
        "%kernel-sha256", "%package-additions", "%package-removals",
    )
    missing_exports = [name for name in exports if name not in module_text]
    if missing_exports:
        raise ValidationError(
            "settings.scm is missing exports: {}".format(", ".join(missing_exports))
        )

    guile = shutil.which("guile")
    if not guile:
        raise MaintainerError("guile is required to validate the settings adapter")
    expression = (
        "(use-modules (securityops settings)) "
        "(unless (string=? %kernel-version \"{}\") (exit 1))"
    ).format(settings["kernel"]["version"])
    environment = os.environ.copy()
    environment["GUILE_AUTO_COMPILE"] = "0"
    command = [guile, "-L", str(repository.root), "-c", expression]
    completed = subprocess.run(
        command,
        cwd=str(repository.root),
        env=environment,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if completed.returncode != 0:
        details = completed.stderr.strip().splitlines()
        suffix = ": {}".format(details[-1]) if details else ""
        raise ValidationError("Guile settings adapter validation failed{}".format(suffix))

    if full:
        guix = shutil.which("guix")
        if not guix:
            raise MaintainerError("guix is required for --full validation")
        with BuildLock(repository):
            missing_integration = [
                warning
                for warning in _integration_state(repository)
                if "does not yet import (securityops settings)" in warning
            ]
            if missing_integration:
                raise ValidationError("; ".join(missing_integration))
            with tempfile.TemporaryDirectory(prefix="securityops-validate-") as temporary:
                installer_config = generate_installer_validation_config(
                    repository, Path(temporary)
                )
                descriptions = (
                    "pinned kernel dry-run",
                    "pinned system-image dry-run",
                    "pinned generated-installer dry-run",
                )
                for description, full_command in zip(
                    descriptions,
                    full_validation_commands(repository, guix, installer_config),
                ):
                    print(">> {}".format(description), flush=True)
                    completed = subprocess.run(
                        full_command,
                        cwd=str(repository.root),
                        check=False,
                    )
                    if completed.returncode != 0:
                        raise ValidationError(
                            "{} failed with exit {}".format(
                                description, completed.returncode
                            )
                        )

    print("Validated schema, versions, official kernel URL, hashes, package overrides,")
    print("and the Guile settings adapter{}.".format(
        " plus pinned kernel/image/installer dry-runs" if full else ""
    ))
    for warning in _integration_state(repository):
        print("warning: {}".format(warning), file=sys.stderr)
    return 0


