def _reject_duplicate_json_keys(pairs: Sequence[Tuple[str, Any]]) -> Dict[str, Any]:
    result: Dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise ValidationError("settings JSON contains duplicate key: {!r}".format(key))
        result[key] = value
    return result


def _expect_object(value: Any, context: str, keys: Iterable[str]) -> Mapping[str, Any]:
    if type(value) is not dict:
        raise ValidationError("{} must be a JSON object".format(context))
    expected = set(keys)
    actual = set(value)
    if actual != expected:
        missing = sorted(expected - actual)
        extra = sorted(actual - expected)
        details: List[str] = []
        if missing:
            details.append("missing {}".format(", ".join(missing)))
        if extra:
            details.append("unknown {}".format(", ".join(extra)))
        raise ValidationError("{} has invalid keys ({})".format(context, "; ".join(details)))
    return value


def _expect_string(value: Any, context: str, maximum: int = 256) -> str:
    if not isinstance(value, str) or not value or len(value) > maximum:
        raise ValidationError("{} must be a non-empty string of at most {} characters".format(
            context, maximum
        ))
    if any(ord(character) < 32 or ord(character) == 127 for character in value):
        raise ValidationError("{} contains a control character".format(context))
    return value


def kernel_url(version: str) -> str:
    """Return the only kernel source URL accepted by this tool."""
    validate_kernel_version(version)
    major = version.split(".", 1)[0]
    return "https://cdn.kernel.org/pub/linux/kernel/v{}.x/linux-{}.tar.xz".format(
        major, version
    )


def validate_kernel_version(version: str) -> None:
    if not isinstance(version, str) or not KERNEL_VERSION_RE.fullmatch(version):
        raise ValidationError("kernel version must be a stable canonical X.Y.Z version")


def validate_package_name(package: str) -> None:
    if not isinstance(package, str) or not PACKAGE_RE.fullmatch(package):
        raise ValidationError(
            "invalid package name {!r}; use a Guix package name containing only "
            "letters, digits, '+', '-', '.', or '_'".format(package)
        )


def package_spec_base(specification: str) -> str:
    """Return PACKAGE from PACKAGE, PACKAGE@VERSION, or PACKAGE:OUTPUT."""
    if not isinstance(specification, str):
        raise ValidationError("package specification must be a string")
    boundaries = [
        position
        for position in (specification.find("@"), specification.find(":"))
        if position >= 0
    ]
    return specification[: min(boundaries)] if boundaries else specification


def package_spec_output(specification: str) -> str:
    """Return OUTPUT from a Guix specification, defaulting to ``out``."""
    return specification.split(":", 1)[1] if ":" in specification else "out"


def package_spec_key(specification: str) -> Tuple[str, str]:
    return package_spec_base(specification), package_spec_output(specification)


def validate_package_specification(specification: str) -> None:
    if not isinstance(specification, str) or not PACKAGE_SPEC_RE.fullmatch(specification):
        raise ValidationError(
            "invalid package specification {!r}; use PACKAGE, PACKAGE@VERSION, "
            "PACKAGE:OUTPUT, or PACKAGE@VERSION:OUTPUT".format(specification)
        )
    validate_package_name(package_spec_base(specification))


def nix_base32_sha256(hexadecimal: str) -> str:
    """Encode a hexadecimal SHA-256 using Guix/Nix's base32 bit ordering."""
    if not isinstance(hexadecimal, str) or not HEX_SHA256_RE.fullmatch(hexadecimal):
        raise ValidationError("cannot encode an invalid hexadecimal SHA-256")
    digest = bytes.fromhex(hexadecimal)
    alphabet = "0123456789abcdfghijklmnpqrsvwxyz"
    encoded: List[str] = []
    character_count = (len(digest) * 8 + 4) // 5
    for position in range(character_count - 1, -1, -1):
        bit = position * 5
        byte_index, shift = divmod(bit, 8)
        value = digest[byte_index] >> shift
        if byte_index + 1 < len(digest):
            value |= digest[byte_index + 1] << (8 - shift)
        encoded.append(alphabet[value & 0x1F])
    return "".join(encoded)


def _validate_package_list(value: Any, context: str, specifications: bool) -> List[str]:
    if type(value) is not list:
        raise ValidationError("{} must be a JSON array".format(context))
    for package in value:
        if specifications:
            validate_package_specification(package)
        else:
            validate_package_name(package)
    if len(value) != len(set(value)):
        raise ValidationError("{} contains a duplicate package".format(context))
    if value != sorted(value):
        raise ValidationError("{} must be sorted".format(context))
    if specifications:
        keys = [package_spec_key(package) for package in value]
        if len(keys) != len(set(keys)):
            raise ValidationError(
                "{} contains multiple specifications for one package output".format(context)
            )
    return value


def validate_settings(data: Any) -> Mapping[str, Any]:
    """Validate the complete settings schema and return *data* unchanged."""
    root = _expect_object(data, "root", ("schema", "release", "kernel", "packages"))
    if type(root["schema"]) is not int or root["schema"] != SCHEMA_VERSION:
        raise ValidationError("schema must be the integer {}".format(SCHEMA_VERSION))

    release = _expect_object(
        root["release"],
        "release",
        ("version", "build_revision", "desktop_label"),
    )
    release_version = _expect_string(release["version"], "release.version", 64)
    if not RELEASE_VERSION_RE.fullmatch(release_version):
        raise ValidationError("release.version must be a stable canonical X.Y.Z version")
    build_revision = _expect_string(
        release["build_revision"], "release.build_revision", 32
    )
    if not BUILD_REVISION_RE.fullmatch(build_revision):
        raise ValidationError("release.build_revision must look like r11")
    _expect_string(release["desktop_label"], "release.desktop_label", 64)

    kernel = _expect_object(
        root["kernel"], "kernel", ("version", "url", "nix_base32", "sha256")
    )
    version = _expect_string(kernel["version"], "kernel.version", 64)
    validate_kernel_version(version)
    url = _expect_string(kernel["url"], "kernel.url", 512)
    expected_url = kernel_url(version)
    if url != expected_url:
        raise ValidationError("kernel.url must be {!r}".format(expected_url))
    nix_hash = _expect_string(kernel["nix_base32"], "kernel.nix_base32", 52)
    if not NIX_BASE32_RE.fullmatch(nix_hash):
        raise ValidationError("kernel.nix_base32 is not a SHA-256 Nix-base32 hash")
    hex_hash = _expect_string(kernel["sha256"], "kernel.sha256", 64)
    if not HEX_SHA256_RE.fullmatch(hex_hash):
        raise ValidationError("kernel.sha256 is not a lowercase hexadecimal SHA-256")
    if nix_base32_sha256(hex_hash) != nix_hash:
        raise ValidationError("kernel.nix_base32 and kernel.sha256 describe different bytes")

    packages = _expect_object(root["packages"], "packages", ("add", "remove"))
    additions = _validate_package_list(packages["add"], "packages.add", True)
    removals = _validate_package_list(packages["remove"], "packages.remove", False)
    overlap = sorted({package_spec_base(package) for package in additions} & set(removals))
    if overlap:
        raise ValidationError(
            "packages.add and packages.remove overlap: {}".format(", ".join(overlap))
        )
    return root


def canonical_settings(data: Mapping[str, Any]) -> Dict[str, Any]:
    """Return a deterministic, independently owned representation."""
    validate_settings(data)
    release = data["release"]
    kernel = data["kernel"]
    packages = data["packages"]
    result: Dict[str, Any] = {
        "schema": SCHEMA_VERSION,
        "release": {
            "version": release["version"],
            "build_revision": release["build_revision"],
            "desktop_label": release["desktop_label"],
        },
        "kernel": {
            "version": kernel["version"],
            "url": kernel["url"],
            "nix_base32": kernel["nix_base32"],
            "sha256": kernel["sha256"],
        },
        "packages": {
            "add": sorted(packages["add"]),
            "remove": sorted(packages["remove"]),
        },
    }
    validate_settings(result)
    return result


def serialize_settings(data: Mapping[str, Any]) -> str:
    return json.dumps(canonical_settings(data), indent=2, ensure_ascii=False) + "\n"


def _open_regular_nofollow(path: Path) -> int:
    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(str(path), flags)
    except FileNotFoundError as error:
        raise MaintainerError("required file does not exist: {}".format(path)) from error
    except OSError as error:
        if error.errno == errno.ELOOP:
            raise MaintainerError("refusing symbolic link: {}".format(path)) from error
        raise MaintainerError("cannot open {}: {}".format(path, error)) from error
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode):
        os.close(descriptor)
        raise MaintainerError("required path is not a regular file: {}".format(path))
    return descriptor


def load_settings(path: Path) -> Dict[str, Any]:
    descriptor = _open_regular_nofollow(path)
    try:
        metadata = os.fstat(descriptor)
        if metadata.st_size > 1024 * 1024:
            raise ValidationError("settings file is unexpectedly larger than 1 MiB")
        with os.fdopen(descriptor, "r", encoding="utf-8") as settings_file:
            descriptor = -1
            try:
                data = json.load(settings_file, object_pairs_hook=_reject_duplicate_json_keys)
            except json.JSONDecodeError as error:
                raise ValidationError(
                    "invalid settings JSON at line {}, column {}: {}".format(
                        error.lineno, error.colno, error.msg
                    )
                ) from error
            except UnicodeDecodeError as error:
                raise ValidationError("settings JSON is not valid UTF-8") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    validate_settings(data)
    return canonical_settings(data)


def atomic_write_settings(path: Path, data: Mapping[str, Any]) -> None:
    """Write validated JSON without exposing a partial destination file."""
    payload = serialize_settings(data).encode("utf-8")
    parent = path.parent
    if parent.is_symlink() or not parent.is_dir():
        raise MaintainerError("settings parent must be a real directory: {}".format(parent))
    try:
        destination = path.lstat()
    except FileNotFoundError:
        destination = None
    if destination is not None and stat.S_ISLNK(destination.st_mode):
        raise MaintainerError("refusing symbolic link: {}".format(path))
    if destination is not None and not stat.S_ISREG(destination.st_mode):
        raise MaintainerError("settings destination is not a regular file: {}".format(path))
    mode = stat.S_IMODE(destination.st_mode) if destination is not None else 0o644

    descriptor = -1
    temporary_name: Optional[str] = None
    try:
        descriptor, temporary_name = tempfile.mkstemp(
            prefix=".settings.json.", suffix=".tmp", dir=str(parent)
        )
        os.fchmod(descriptor, mode)
        with os.fdopen(descriptor, "wb") as temporary_file:
            descriptor = -1
            temporary_file.write(payload)
            temporary_file.flush()
            os.fsync(temporary_file.fileno())
        if path.is_symlink():
            raise MaintainerError("refusing symbolic link created at destination: {}".format(path))
        os.replace(temporary_name, str(path))
        temporary_name = None
        directory_flags = os.O_RDONLY
        if hasattr(os, "O_DIRECTORY"):
            directory_flags |= os.O_DIRECTORY
        directory_descriptor = os.open(str(parent), directory_flags)
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary_name is not None:
            try:
                os.unlink(temporary_name)
            except FileNotFoundError:
                pass


class BuildLock:
    """Non-blocking exclusive lock shared with build.sh and make-iso.sh."""

    def __init__(self, repository: Repository):
        self.repository = repository
        self.descriptor: Optional[int] = None

    def __enter__(self) -> "BuildLock":
        out_dir = self.repository.out_dir
        if out_dir.is_symlink():
            raise MaintainerError("refusing symbolic-link output directory: {}".format(out_dir))
        if out_dir.exists() and not out_dir.is_dir():
            raise MaintainerError("output path is not a directory: {}".format(out_dir))
        out_dir.mkdir(mode=0o755, parents=False, exist_ok=True)

        flags = os.O_RDWR | os.O_CREAT | os.O_APPEND
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        try:
            descriptor = os.open(str(self.repository.lock_path), flags, 0o600)
        except OSError as error:
            if error.errno == errno.ELOOP:
                raise MaintainerError(
                    "refusing symbolic-link build lock: {}".format(
                        self.repository.lock_path
                    )
                ) from error
            raise MaintainerError("cannot open build lock: {}".format(error)) from error
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            os.close(descriptor)
            raise MaintainerError("build lock is not a regular file")
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            os.close(descriptor)
            raise BuildBusyError(
                "an ISO build is active; settings were not changed"
            ) from error
        self.descriptor = descriptor
        return self

    def __exit__(self, exc_type: Any, exc: Any, traceback: Any) -> None:
        if self.descriptor is not None:
            fcntl.flock(self.descriptor, fcntl.LOCK_UN)
            os.close(self.descriptor)
            self.descriptor = None


def _settings_diff(before: Mapping[str, Any], after: Mapping[str, Any]) -> str:
    return "".join(
        difflib.unified_diff(
            serialize_settings(before).splitlines(keepends=True),
            serialize_settings(after).splitlines(keepends=True),
            fromfile="securityops/settings.json (current)",
            tofile="securityops/settings.json (proposed)",
        )
    )


def _mutate_settings_locked(
    repository: Repository,
    transform: Callable[[Dict[str, Any]], None],
    dry_run: bool,
) -> Tuple[bool, Dict[str, Any]]:
    before = load_settings(repository.settings_path)
    after = copy.deepcopy(before)
    transform(after)
    after = canonical_settings(after)
    changed = serialize_settings(before) != serialize_settings(after)
    if not changed:
        print("Settings already match the request; nothing to change.")
        return False, after
    difference = _settings_diff(before, after)
    if dry_run:
        print(difference, end="")
        print("Dry run: settings were not written.")
    else:
        atomic_write_settings(repository.settings_path, after)
        print(difference, end="")
        print("Updated {} atomically.".format(repository.settings_path))
    return True, after


def mutate_settings(
    repository: Repository,
    transform: Callable[[Dict[str, Any]], None],
    dry_run: bool = False,
) -> Tuple[bool, Dict[str, Any]]:
    with BuildLock(repository):
        return _mutate_settings_locked(repository, transform, dry_run)


def update_package_overrides(
    data: Dict[str, Any],
    additions: Sequence[str] = (),
    removals: Sequence[str] = (),
    resets: Sequence[str] = (),
) -> None:
    for package in additions:
        validate_package_specification(package)
    for package in list(removals) + list(resets):
        validate_package_name(package)
    addition_keys = [package_spec_key(package) for package in additions]
    if len(addition_keys) != len(set(addition_keys)):
        raise ValidationError("only one added specification is allowed per package output")
    addition_bases = [base for base, _output in addition_keys]
    add_request = set(additions)
    add_request_bases = set(addition_bases)
    remove_request = set(removals)
    reset_request = set(resets)
    conflicts = (add_request_bases & remove_request) | (add_request_bases & reset_request) | (
        remove_request & reset_request
    )
    if conflicts:
        raise ValidationError(
            "the same package cannot have multiple actions: {}".format(
                ", ".join(sorted(conflicts))
            )
        )

    current_add = set(data["packages"]["add"])
    current_remove = set(data["packages"]["remove"])
    for package in reset_request:
        current_add = {
            specification
            for specification in current_add
            if package_spec_base(specification) != package
        }
        current_remove.discard(package)
    for package in remove_request:
        current_add = {
            specification
            for specification in current_add
            if package_spec_base(specification) != package
        }
        current_remove.add(package)
    for specification in add_request:
        base = package_spec_base(specification)
        key = package_spec_key(specification)
        current_remove.discard(base)
        current_add = {
            existing
            for existing in current_add
            if package_spec_key(existing) != key
        }
        current_add.add(specification)
    data["packages"]["add"] = sorted(current_add)
    data["packages"]["remove"] = sorted(current_remove)


def _sha256_file(path: Path) -> str:
    descriptor = _open_regular_nofollow(path)
    digest = hashlib.sha256()
    try:
        with os.fdopen(descriptor, "rb") as source:
            descriptor = -1
            while True:
                chunk = source.read(1024 * 1024)
                if not chunk:
                    break
                digest.update(chunk)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    return digest.hexdigest()


def fetch_kernel_metadata(
    version: str,
    repository: Repository,
    runner: Callable[..., subprocess.CompletedProcess[str]] = subprocess.run,
) -> Dict[str, str]:
    """Download an official kernel origin and calculate both required hashes."""
    url = kernel_url(version)
    guix = shutil.which("guix")
    if not guix:
        raise MaintainerError("guix is required to resolve a kernel source hash")
    command = [guix, "download", "--format=nix-base32", url]
    print("Downloading and hashing official Linux {} source...".format(version), flush=True)
    completed = runner(
        command,
        cwd=str(repository.root),
        stdout=subprocess.PIPE,
        text=True,
        check=False,
    )
    if completed.returncode != 0:
        raise MaintainerError(
            "guix download failed for Linux {} (exit {})".format(
                version, completed.returncode
            )
        )
    lines = [line.strip() for line in completed.stdout.splitlines() if line.strip()]
    hashes = [line for line in lines if NIX_BASE32_RE.fullmatch(line)]
    paths = [Path(line) for line in lines if line.startswith("/")]
    if len(hashes) != 1 or len(paths) != 1:
        raise MaintainerError("could not parse the path and Nix-base32 hash from guix download")
    source = paths[0]
    if not source.name.endswith("-linux-{}.tar.xz".format(version)):
        raise MaintainerError("guix returned an unexpected kernel source path: {}".format(source))
    local_sha256 = _sha256_file(source)
    if not HEX_SHA256_RE.fullmatch(local_sha256):
        raise MaintainerError("local kernel SHA-256 calculation returned an invalid value")
    local_nix_base32 = nix_base32_sha256(local_sha256)
    if local_nix_base32 != hashes[0]:
        raise MaintainerError(
            "guix download hash does not match the locally hashed kernel source"
        )
    return {
        "version": version,
        "url": url,
        "nix_base32": hashes[0],
        "sha256": local_sha256,
    }


def set_kernel(data: Dict[str, Any], metadata: Mapping[str, str]) -> None:
    candidate = {
        "version": metadata["version"],
        "url": metadata["url"],
        "nix_base32": metadata["nix_base32"],
        "sha256": metadata["sha256"],
    }
    temporary = copy.deepcopy(data)
    temporary["kernel"] = candidate
    validate_settings(temporary)
    data["kernel"] = candidate


def set_release(
    data: Dict[str, Any],
    version: str,
    revision: str,
    desktop_label: Optional[str] = None,
) -> None:
    if not isinstance(version, str) or not RELEASE_VERSION_RE.fullmatch(version):
        raise ValidationError("release version must be a stable canonical X.Y.Z version")
    if not isinstance(revision, str) or not BUILD_REVISION_RE.fullmatch(revision):
        raise ValidationError("release revision must look like r11")
    if desktop_label is not None:
        _expect_string(desktop_label, "release.desktop_label", 64)
    candidate = copy.deepcopy(data["release"])
    candidate["version"] = version
    candidate["build_revision"] = revision
    if desktop_label is not None:
        candidate["desktop_label"] = desktop_label
    temporary = copy.deepcopy(data)
    temporary["release"] = candidate
    validate_settings(temporary)
    data["release"] = candidate


def positive_integer(value: str) -> int:
    try:
        parsed = int(value, 10)
    except ValueError as error:
        raise argparse.ArgumentTypeError("must be a positive integer") from error
    if parsed < 1:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return parsed


def build_invocation(
    repository: Repository,
    bundle: bool = False,
    prune_old: bool = False,
    jobs: Optional[int] = None,
    cores: Optional[int] = None,
) -> List[str]:
    command = [str(repository.build_script)]
    if bundle:
        command.append("--bundle")
    if prune_old:
        command.append("--prune-old")
    if jobs is not None:
        if jobs < 1:
            raise ValidationError("jobs must be a positive integer")
        command.extend(("--jobs", str(jobs)))
    if cores is not None:
        if cores < 1:
            raise ValidationError("cores must be a positive integer")
        command.extend(("--cores", str(cores)))
    return command


def _builder_has_lock_handoff(repository: Repository) -> bool:
    try:
        build_text = repository.build_script.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return False
    return LOCK_HELD_ENV in build_text and LOCK_FD_ENV in build_text


def run_build(
    repository: Repository,
    bundle: bool = False,
    prune_old: bool = False,
    jobs: Optional[int] = None,
    cores: Optional[int] = None,
    dry_run: bool = False,
    held_lock: Optional[BuildLock] = None,
    runner: Callable[..., subprocess.CompletedProcess[Any]] = subprocess.run,
) -> int:
    load_settings(repository.settings_path)
    script = repository.build_script
    descriptor = _open_regular_nofollow(script)
    metadata = os.fstat(descriptor)
    os.close(descriptor)
    if not metadata.st_mode & stat.S_IXUSR:
        raise MaintainerError("build script is not executable: {}".format(script))
    command = build_invocation(
        repository, bundle=bundle, prune_old=prune_old, jobs=jobs, cores=cores
    )
    print("Build command: {}".format(shlex.join(command)))
    if dry_run:
        print("Dry run: the ISO build was not started.")
        return 0
    environment = os.environ.copy()
    run_arguments: Dict[str, Any] = {
        "cwd": str(repository.root),
        "env": environment,
        "check": False,
    }
    if held_lock is not None:
        if held_lock.repository != repository or held_lock.descriptor is None:
            raise MaintainerError("cannot hand off an invalid build lock")
        if not _builder_has_lock_handoff(repository):
            raise MaintainerError(
                "make-iso.sh does not support the inherited-lock protocol; "
                "the build was not started"
            )
        environment[LOCK_HELD_ENV] = "1"
        environment[LOCK_FD_ENV] = str(held_lock.descriptor)
        run_arguments["pass_fds"] = (held_lock.descriptor,)
    completed = runner(command, **run_arguments)
    return completed.returncode


def probe_build_lock(repository: Repository) -> str:
    lock_path = repository.lock_path
    if not lock_path.exists() and not lock_path.is_symlink():
        return "idle"
    if lock_path.is_symlink():
        return "unsafe (lock is a symbolic link)"
    try:
        descriptor = _open_regular_nofollow(lock_path)
    except MaintainerError as error:
        return "unknown ({})".format(error)
    try:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return "active"
        else:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
            return "idle"
    finally:
        os.close(descriptor)


def human_bytes(size: int) -> str:
    value = float(size)
    for suffix in ("B", "KiB", "MiB", "GiB", "TiB"):
        if value < 1024.0 or suffix == "TiB":
            return "{:.1f} {}".format(value, suffix)
        value /= 1024.0
    return "{} B".format(size)


def latest_iso(repository: Repository) -> Optional[Path]:
    if not repository.out_dir.is_dir() or repository.out_dir.is_symlink():
        return None
    candidates = [
        path
        for path in repository.out_dir.glob("securityops-live-*.iso")
        if path.is_file() and not path.is_symlink()
    ]
    return max(candidates, key=lambda path: path.stat().st_mtime_ns) if candidates else None


def show_status(repository: Repository) -> int:
    settings = load_settings(repository.settings_path)
    print("Security Ops OS maintainer status")
    print("  release: {} ({}, {})".format(
